#!/bin/sh
# vicine - Watch and download anything from terminal

version_number="1.7.0"

# ─── UI ─────────────────────────────────────────────────────────────────────

# TTY detection — disable colors when piped
if [ -t 1 ]; then
    ESC=$(printf '\033')
    C_RESET="${ESC}[0m"
    C_BOLD="${ESC}[1m"
    C_DIM="${ESC}[2m"
    C_RED="${ESC}[1;31m"
    C_GREEN="${ESC}[1;32m"
    C_YELLOW="${ESC}[1;33m"
    C_BLUE="${ESC}[1;34m"
    C_CYAN="${ESC}[1;36m"
    C_WHITE="${ESC}[1;37m"
    C_GRAY="${ESC}[2;37m"
else
    C_RESET=""
    C_BOLD=""
    C_DIM=""
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_BLUE=""
    C_CYAN=""
    C_WHITE=""
    C_GRAY=""
fi

die() {
    printf "\33[2K\r${C_RED}  x %s${C_RESET}\n" "$*" >&2
    _exit_code=1
    exit 1
}

info() {
    printf "\33[2K\r${C_BLUE}  :: %s${C_RESET}\n" "$*"
}

warn() {
    printf "\33[2K\r${C_YELLOW}  :: %s${C_RESET}\n" "$*"
}

ok() {
    printf "\33[2K\r${C_GREEN}  ✓ %s${C_RESET}\n" "$*"
}

# Portable horizontal rule (no bash brace expansion)
hr() {
    awk -v n="${1:-50}" 'BEGIN { for (i=0; i<n; i++) printf "─" }'
}

# $1 = prompt, $2 = extra flags
menu() {
    case "$menu_program" in
        fzf) fzf --reverse --cycle --prompt "$1" $2 $menu_extra_flags ;;
        rofi) rofi -sort -dmenu -i -p "$1" $2 $menu_extra_flags ;;
        dmenu) dmenu -l 20 -p "$1" $menu_extra_flags ;;
        *) "$menu_program" $menu_extra_flags "$1" ;;
    esac
}

# Read a picker choice into $_pick; stdin is the display list, $1 the prompt,
# $2 extra menu flags. Returns 1 when nothing was chosen.
# With -n set — or with no TTY, where the script defaults it to 0 — the nth
# row is taken instead of opening a menu. Without this, a piped or cron run
# left these pickers unable to open a menu, took the empty result as "nothing
# picked", and exited 0 having played nothing.
picker() {
    _pick_list="$(cat)"
    if [ -n "$select_nth" ]; then
        _pick_n="$(printf '%s\n' "$_pick_list" | grep -c .)"
        [ "$select_nth" -lt "$_pick_n" ] 2>/dev/null || die "Selection ${select_nth} out of range (0-$((_pick_n - 1)))"
        _pick="$(printf '%s\n' "$_pick_list" | sed -n "$((select_nth + 1))p")"
    else
        _pick="$(printf '%s\n' "$_pick_list" | menu "$1" $2)" || true
    fi
    [ -n "$_pick" ]
}

# quality picker: "best" + the qualities given on stdin; prints the choice
pick_quality_menu() {
    _pq_list="$(cat 2>/dev/null || true)"
    [ -n "$_pq_list" ] || _pq_list=$(printf '480p\n720p\n1080p\n2160p')
    printf 'best\n%s\n' "$_pq_list" | menu "$1" || true
}

