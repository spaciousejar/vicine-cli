# ─── Anime provider

anidb_curl() {
    $curl_exe -sL -A "$anime_agent" --max-time 10 "$@"
}

# search → lines "anime_id<TAB>title"
anidb_search() {
    _q=$(henc "$1")
    _page="$(anidb_curl "$(printf "$anime_search_api" "$_q")" | tr '\n' ' ' | sed 's|<a href|\n<a href|g')"
    [ -z "$_page" ] && return 1
    printf "%s" "$_page" | sed -nE 's|.*href="[^"]*/watch/[^"]+"[^>]*title="([^"]*)"[^>]*data-id="([0-9]+)".*|\2\t\1|p' | sed -e "s|&#0*39;|'|g" -e "s|&#x27;|'|g" -e 's|&quot;|"|g'
}

# episodes for anime → lines "ep_id<TAB>ep_no" (JSON html unwrapped via jq)
# the list can be ~1MB, so give this call a longer timeout than the default 10s
anidb_episodes() {
    _page="$(anidb_curl --max-time 30 "$(printf "$anime_episodes_api" "${1##*-}")" | jq -r '.html // empty')"
    printf "%s" "$_page" | tr '\n' ' ' | sed 's|data-number=|\ndata-number=|g' | sed -nE 's|.*data-number="([0-9]+)"[[:space:]]*data-id="([0-9]+)".*|\2\t\1|p' | awk '!seen[$0]++'
}

# zokoanime embed: window.__P is XOR("otaku-embed-v1") of base64(JSON) → m3u8 src
ANIME_ZOKO_KEY="otaku-embed-v1"
zoko_xor() {
    # base64 → od decimal bytes → numeric XOR with key → plaintext JSON (ASCII)
    _kn="$(printf '%s' "$ANIME_ZOKO_KEY" | od -An -v -tu1 | sed 's/^ *//')"
    { base64 -d 2>/dev/null || base64 -D 2>/dev/null; } |
        od -An -v -tu1 |
        awk -v kn="$_kn" '
            function bxor(a,b,  i,r){ for(i=0;i<8;i++){ r+=((a%2)!=(b%2))*2^i; a=int(a/2); b=int(b/2) } return r }
            BEGIN { n=split(kn, kc, /[ \n]+/); idx=0 }
            { for (i=1;i<=NF;i++){ printf "%c", bxor($i, kc[(idx%n)+1]); idx++ } }'
}
zoko_src_of() {
    _page="$1"
    _blob="$(printf "%s" "$_page" | sed -nE 's|.*window\.__P="([^"]+)".*|\1|p' | head -n 1)"
    [ -z "$_blob" ] && return 1
    _dec="$(printf "%s" "$_blob" | zoko_xor)"
    [ -z "$_dec" ] && return 1
    printf "%s" "$_dec" | grep -oE '"src":"[^"]+"' | head -n 1 | sed -E 's|^"src":"||; s|"$||'
}

# CDN calls are referer-gated by hls.1embed.buzz
anime_cdn_curl() {
    $curl_exe -sL -A "$anime_agent" -e "$anime_embed_ref" --max-time 15 "$@"
}

# extract m3u8 quality list ("RES>URL" lines, best first) for ep
anidb_m3u8() {
    _ep_id=$(printf "%s" "$anime_ep_maps" | sed -nE "s|^([0-9]+)\t${1}$|\1|p")
    _lang="sub"
    [ "$anime_mode" = "dub" ] && _lang="dub"
    _page="$(anidb_curl "$(printf "$anime_servers_api" "${_ep_id}")" | jq -r '.html // empty')"
    _hash="$(printf "%s" "$_page" | tr '\n' ' ' | sed -nE "s|.*server-item[^>]*data-type=\"${_lang}\"[^>]*data-server-name=\"ZokoAnime\"[^>]*data-hash=\"([^\"]+)\".*|\1|p" | head -n 1)"
    # only ZokoAnime embeds are decodable (MegaPlay/Vidstream need AES + segment prefix-stripping)
    [ -z "$_hash" ] && return 1
    _embed="$(printf "%s" "$_hash" | base64 -d 2>/dev/null || printf "%s" "$_hash" | base64 -D 2>/dev/null)"
    _embed_page="$(anime_cdn_curl "$_embed")"
    _master="$(zoko_src_of "$_embed_page")"
    [ -z "$_master" ] && return 1
    _mp="$(anime_cdn_curl "$_master")"
    _master_dir="$(dirname "$_master")"
    _variants="$(printf "%s" "$_mp" | grep -E '^[0-9]+/index\.m3u8$')"
    if [ -z "$_variants" ]; then
        printf "auto>%s\n" "$_master"
        return 0
    fi
    printf "%s\n" "$_mp" | while IFS= read -r _line; do
        case "$_line" in
            *RESOLUTION=*) _res="$(printf "%s" "$_line" | sed -nE 's|.*RESOLUTION=[0-9]+x([0-9]+).*|\1|p')" ;;
        esac
        case "$_line" in
            [0-9]*/index.m3u8)
                # fall back to the variant's path prefix when RESOLUTION is absent
                [ -z "$_res" ] && _res="$(printf '%s' "$_line" | sed -nE 's|^([0-9]+)/.*|\1|p')"
                case "$_line" in
                    http*) _url="$_line" ;;
                    *)     _url="$_master_dir/$_line" ;;
                esac
                printf "%sp>%s\n" "$_res" "$_url" ;;
        esac
    done | sort -rn
}

# pick quality variant → prints chosen m3u8 line to stdout (sets nothing)
anime_pick_quality() {
    _links="$1"
    case "$quality" in
        best)  _result=$(printf "%s" "$_links" | head -n 1) ;;
        worst) _result=$(printf "%s" "$_links" | grep -E '^[0-9]{3,4}' | tail -n 1) ;;
        *)     _result=$(printf "%s" "$_links" | grep -m 1 -F "$quality") ;;
    esac
    [ -z "$_result" ] && printf "%s" "$_links" | head -n 1 || printf "%s" "$_result"
}

# play anime: resolves stream URL and reuses hicine player/history
anime_play_episode() {
    _ep_no="$1"
    _links="$(anidb_m3u8 "$_ep_no")" || { warn "No sources found for ep $_ep_no"; return 1; }
    [ -z "$_links" ] && { warn "No sources found for ep $_ep_no"; return 1; }
    _chosen="$(anime_pick_quality "$_links")"
    _video_link="$(printf "%s" "$_chosen" | cut -d ">" -f 2)"
    [ -z "$_video_link" ] && { warn "No valid stream for ep $_ep_no."; return 1; }
    if [ "$download_all_mode" = 1 ]; then
        _safe="$(printf "%s" "$anime_title" | sed 's/[^a-zA-Z0-9 ._-]//g' | tr ' ' '_')"
        _epnum=$(printf '%02d' "$_ep_no")
        do_download "$_video_link" "${_safe}/season-1/Ep${_epnum}" "$anime_embed_ref"
    else
        info "Playing ep ${_ep_no}: ${anime_title}"
        play_url "$_video_link" "$anime_title - Episode $_ep_no" "$anime_embed_ref"
        _rc=$?
        update_history "$anime_id" "$anime_title" anime 0 "$_ep_no"
        [ "$exit_after_play" = 1 ] && exit "$_rc"
    fi
}

# play loop for anime.
# Globals used: anime_ep_list, anime_title, _cur_ep, _range_end
anime_play_loop() {
    while true; do
        if ! printf "%s\n" "$anime_ep_list" | grep -qx "$_cur_ep"; then
            warn "Episode $_cur_ep not available."
            break
        fi
        anime_play_episode "$_cur_ep"

        # auto-advance in range mode
        if [ -n "$_range_end" ]; then
            _last="$(printf "%s\n" "$anime_ep_list" | tail -1)"
            if [ "$_cur_ep" = "$_range_end" ] || [ "$_cur_ep" = "$_last" ]; then
                unset _range_end
            else
                _cur_ep="$(printf "%s\n" "$anime_ep_list" | awk -v n="$_cur_ep" '$1==n{getline; print; exit}')"
                continue
            fi
        fi

        # control menu
        _line="$(printf "%s\n" "$anime_ep_list" | grep -n "^$_cur_ep$" | cut -d: -f1)"
        _is_first=0; [ "$_line" = "1" ] && _is_first=1
        _is_last=0; [ "$_cur_ep" = "$(printf "%s\n" "$anime_ep_list" | tail -1)" ] && _is_last=1
        printf "" > "$tmpfile3"
        printf "replay\n" >> "$tmpfile3"
        [ "$_is_first" = 0 ] && printf "previous\n" >> "$tmpfile3"
        [ "$_is_last" = 0 ] && printf "next\n" >> "$tmpfile3"
        printf "select\nchange_quality\nquit\n" >> "$tmpfile3"
        _ctrl=$(cat "$tmpfile3" | menu "Playing ep ${_cur_ep}: ${anime_title}... " || true)
        [ -z "$_ctrl" ] && break
        case "$_ctrl" in
            next)
                _next="$(printf "%s\n" "$anime_ep_list" | awk -v n="$_cur_ep" '$1==n{getline; print; exit}')"
                [ -n "$_next" ] && [ "$_next" != "$_cur_ep" ] && _cur_ep="$_next"
                ;;
            previous)
                _cur_ep="$(printf "%s\n" "$anime_ep_list" | awk -v n="$_cur_ep" '{if($1==n)print prev; prev=$1}')"
                ;;
            replay)   ;;
            select)
                _pick="$(printf "%s\n" "$anime_ep_list" | nl -w 2 | sed 's/^[[:space:]]*//' | sed 's/\t/  /' | menu "Select episode: " || true)"
                [ -n "$_pick" ] && _cur_ep="$(printf "%s\n" "$anime_ep_list" | sed -n "$(printf "%s" "$_pick" | awk '{print $1+0}')p")"
                ;;
            change_quality)
                _new_q=$(printf 'best\n480p\n720p\n1080p\n2160p\n' | menu "Quality: " || true)
                [ -n "$_new_q" ] && quality="$_new_q"
                ;;
            quit|*)   break ;;
        esac
    done
}

# Resume an anime from history: fetch episode map for stored id, then play loop
anime_resume() {
    anime_id="$1"
    anime_title="$2"
    _ep_db="$3"
    info "Fetching episodes for $anime_title"
    anime_ep_maps="$(anidb_episodes "$anime_id")"
    if [ -z "$anime_ep_maps" ]; then
        warn "No episodes found — this history entry was written by an older provider. Clear it with 'vicine -C'."
        return 1
    fi
    anime_ep_list="$(printf "%s" "$anime_ep_maps" | cut -f 2)"
    [ -z "$anime_ep_list" ] && die "No episodes found for $anime_title."
    _cur_ep="$_ep_db"
    if ! printf "%s\n" "$anime_ep_list" | grep -qx "$_cur_ep"; then
        warn "Episode $_cur_ep not available; starting from latest."
        _cur_ep="$(printf "%s\n" "$anime_ep_list" | tail -1)"
    fi
    _range_end=""
    anime_play_loop
}

# main anime flow: search → select → episode select → play loop
cmd_anime() {
    _query="$1"
    [ -z "$_query" ] && die "Missing anime search query"

    anime_list="$(anidb_search "$_query")"
    [ -z "$anime_list" ] && die "No results found."

    # select anime (index-prefixed non-interactive or menu)
    if [ -n "$select_nth" ]; then
        _ncount=$(printf "%s\n" "$anime_list" | wc -l | tr -d ' ')
        [ "$select_nth" -ge "$_ncount" ] 2>/dev/null && die "Selection ${select_nth} out of range (0-$((_ncount - 1)))"
        _result="$(printf "%s\n" "$anime_list" | sed -n "$((select_nth + 1))p")"
    else
        _result="$(printf "%s\n" "$anime_list" | nl -w 2 | sed 's/^[[:space:]]*//' | sed 's/\t/  /' | menu "Select anime: " || true)"
        [ -z "$_result" ] && return 0
        _result="$(printf "%s\n" "$anime_list" | sed -n "$(printf "%s" "$_result" | awk '{print $1+0}')p")"
    fi
    [ -z "$_result" ] && die "Invalid anime selection"
    anime_id="$(printf "%s" "$_result" | cut -f 1)"
    anime_title="$(printf "%s" "$_result" | cut -f 2)"

    info "Fetching episodes for $anime_title"
    anime_ep_maps="$(anidb_episodes "$anime_id")"
    [ -z "$anime_ep_maps" ] && die "No episodes found."
    anime_ep_list="$(printf "%s" "$anime_ep_maps" | cut -f 2)"

    if [ "$info_only" -eq 1 ] && [ "$download_all_mode" -eq 0 ]; then
        _total=$(printf "%s\n" "$anime_ep_list" | wc -l | tr -d ' ')
        printf "  %s\n  %s episodes\n" "$anime_title" "$_total"
        return 0
    fi

    # Download-all mode: interactive quality + episode-range pick, then confirm
    if [ "$download_all_mode" = 1 ]; then
        _dl_range=""
        if [ -t 0 ]; then
            case "$menu_program" in fzf) menu_multi_flag="-m" ;; rofi) menu_multi_flag="-multi-select" ;; *) menu_multi_flag="" ;; esac
            _new_q=$(printf 'best\n480p\n720p\n1080p\n2160p\n' | menu "Quality to download: " || true)
            [ -n "$_new_q" ] && quality="$_new_q"
            printf "\n  Episode range to download (e.g. 1-50, empty = all): "
            read -r _dl_range
        fi
        if [ -n "$_dl_range" ]; then
            _rstart=$(printf "%s" "$_dl_range" | grep -oE '^[0-9]+' | head -1)
            _rend=$(printf "%s" "$_dl_range" | grep -oE '[0-9]+$' | tail -1)
            [ -n "$_rstart" ] || die "Invalid episode range: $_dl_range"
            [ -n "$_rend" ] || die "Invalid episode range: $_dl_range"
            _total=$(printf "%s\n" "$anime_ep_list" | awk -v s="$_rstart" -v e="$_rend" '$1>=s && $1<=e' | wc -l | tr -d ' ')
        else
            _rstart=""
            _rend=""
            _total=$(printf "%s\n" "$anime_ep_list" | wc -l | tr -d ' ')
        fi
        printf "\n  ${C_YELLOW}Download ${_total} episode(s) of '${anime_title}'?${C_RESET} [y/N] "
        read -r _yn
        [ "$_yn" != "y" ] && [ "$_yn" != "Y" ] && exit 0
        printf "%s\n" "$anime_ep_list" | while IFS= read -r _ep; do
            if [ -n "$_rstart" ]; then
                [ "$_ep" -ge "$_rstart" ] 2>/dev/null || continue
                [ "$_ep" -le "$_rend" ] 2>/dev/null || continue
            fi
            anime_play_episode "$_ep"
        done
        return
    fi

    # select episode: -e flag / range / -1 / interactive
    case "$requested_eps" in
        "" ) 
            if [ -n "$resume_ep" ]; then
                _cur_ep="$resume_ep"
            else
                _pick="$(printf "%s\n" "$anime_ep_list" | nl -w 2 | sed 's/^[[:space:]]*//' | sed 's/\t/  /' | menu "Select episode: " || true)"
                [ -z "$_pick" ] && return 0
                _cur_ep="$(printf "%s" "$_pick" | grep -oE '[0-9]+' | head -1)"
            fi
            ;;
        -1 ) _cur_ep="$(printf "%s\n" "$anime_ep_list" | tail -1)" ;;
        *-* )
            _start=$(printf "%s" "$requested_eps" | grep -oE '^(-1|[0-9]+)' | head -1)
            _end=$(printf "%s" "$requested_eps" | grep -oE '(-1|[0-9]+)$' | tail -1)
            printf "%s\n" "$anime_ep_list" | grep -qx "$_start" || die "Episode $_start not found."
            _cur_ep="$_start"
            if [ "$_end" = "-1" ]; then
                _range_end="last"
            else
                printf "%s\n" "$anime_ep_list" | grep -qx "$_end" || die "Episode $_end not found."
                _range_end="$_end"
            fi
            ;;
        * ) 
            printf "%s\n" "$anime_ep_list" | grep -qx "$requested_eps" || die "Episode $requested_eps not found."
            _cur_ep="$requested_eps"
            ;;
    esac

    # play loop (control menu)
    anime_play_loop
}

# ─── Self-update ────────────────────────────────────────────────────────────

update_script() {
    _repo="${VICINE_UPDATE_URL:-https://raw.githubusercontent.com/spaciousejar/vicine-cli/master/vicine}"
    info "Checking for updates..."
    _new="$(curl -sfL "$_repo")" || die "Update failed: cannot fetch $_repo"
    _new_ver="$(printf "%s" "$_new" | sed -n 's/^version_number="\([^"]*\)"/\1/p')"
    [ -z "$_new_ver" ] && die "Invalid response from update server."

    _cur_ver="$(printf '%s' "$version_number" | tr -dc '0-9.')"
    _nxt_ver="$(printf '%s' "$_new_ver" | tr -dc '0-9.')"
    if [ "$_nxt_ver" = "$_cur_ver" ]; then
        ok "Already up to date ($version_number)"
        exit 0
    fi

    # upgrade only — never downgrade or patch over a never-newer remote
    _newer=$(awk -v cur="$_cur_ver" -v nxt="$_nxt_ver" '
        function max(a,b){return a>b?a:b}
        function cmp(x,y){ n=max(split(x,a,"."), split(y,b,"."));
            for(i=1;i<=n;i++){ av=a[i]+0; bv=b[i]+0; if(av<bv)return -1; if(av>bv)return 1 } return 0 }
        BEGIN { c=cmp(cur,nxt); print (c<0)?1:0 }')
    [ "$_newer" = "1" ] || die "Remote ($_new_ver) is not newer than local ($version_number)"

    # validate the payload before replacing the script
    printf "%s\n" "$_new" | sh -n >/dev/null 2>&1 || die "Fetched script failed syntax check — not updating."
    # atomic replace: write a temp next to the target, then mv. This both
    # surfaces write failures and avoids the running shell reading a half-
    # written file (dash reads scripts in chunks).
    _tmp="$0.tmp.$$"
    if printf "%s\n" "$_new" > "$_tmp" && chmod 755 "$_tmp" && mv -f "$_tmp" "$0"; then
        ok "Updated: $version_number -> $_new_ver"
        exit 0
    fi
    rm -f "$_tmp"
    die "Update failed: cannot write $0 — check permissions or run as the file owner."
}

uninstall_self() {
    _bin="$0"
    case "$_bin" in
        */*) ;;
        *) _bin="$(command -v "$_bin" 2>/dev/null || printf '%s' "$_bin")" ;;
    esac
    case "$_bin" in
        */*) _bin="$(cd "$(dirname "$_bin")" 2>/dev/null && pwd)/$(basename "$_bin")" ;;
    esac
    [ -e "$_bin" ] || die "Cannot locate installed script (expected $_bin)"
    if rm -f "$_bin"; then
        ok "Uninstalled $_bin"
    else
        die "Uninstalled: cannot remove $_bin — check permissions."
    fi
    if [ -d "$(dirname "$histfile")" ]; then
        warn "Watch history kept at $(dirname "$histfile") — remove manually if undesired"
    fi
    exit 0
}

