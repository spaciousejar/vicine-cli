#!/bin/sh
# vicine - Watch and download movies

version_number="1.0.0"

# ─── UI ─────────────────────────────────────────────────────────────────────

# TTY detection — disable colors when piped
if [ -t 1 ]; then
    C_RESET="\033[0m"
    C_BOLD="\033[1m"
    C_DIM="\033[2m"
    C_RED="\033[1;31m"
    C_GREEN="\033[1;32m"
    C_YELLOW="\033[1;33m"
    C_BLUE="\033[1;34m"
    C_CYAN="\033[1;36m"
    C_MAGENTA="\033[1;35m"
    C_WHITE="\033[1;37m"
    C_GRAY="\033[2;37m"
else
    C_RESET=""
    C_BOLD=""
    C_DIM=""
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_BLUE=""
    C_CYAN=""
    C_MAGENTA=""
    C_WHITE=""
    C_GRAY=""
fi

die() {
    printf "\33[2K\r${C_RED}  x %s${C_RESET}\n" "$*" >&2
    exit 1
}

info() {
    printf "\33[2K\r${C_BLUE}  :: %s${C_RESET}\n" "$*"
}

warn() {
    printf "\33[2K\r${C_YELLOW}  :: %s${C_RESET}\n" "$*"
}

ok() {
    printf "\33[2K\r${C_GREEN}  ✓ %s${C_RESET}\n" "$*"
}

# Spinner for long operations
spinner() {
    _msg="$1"
    _sp='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    _i=0
    while kill -0 "$$" 2>/dev/null; do
        printf "\33[2K\r${C_CYAN}  ${_sp:$_i:1} %s${C_RESET}" "$_msg" >&2
        _i=$(( (_i + 1) % ${#_sp} ))
        sleep 0.1
    done &
    _spinner_pid=$!
}

stop_spinner() {
    [ -n "$_spinner_pid" ] && kill "$_spinner_pid" 2>/dev/null
    wait "$_spinner_pid" 2>/dev/null
    printf "\33[2K\r" >&2
}

# $1 = prompt, $2 = extra flags
menu() {
    case "$menu_program" in
        fzf) fzf --reverse --cycle --prompt "$1" $2 $menu_extra_flags ;;
        rofi) rofi -sort -dmenu -i -p "$1" $2 $menu_extra_flags ;;
        dmenu) dmenu -l 20 -p "$1" $menu_extra_flags ;;
        *) "$menu_program" $menu_extra_flags "$1" ;;
    esac
}

help_info() {
    cat <<EOF

${C_CYAN}${C_BOLD}  hicine${C_RESET} ${C_DIM}v${version_number}${C_RESET}  ${C_GRAY}Watch and download movies from hicine.sbs${C_RESET}

${C_WHITE}Usage:${C_RESET}
    ${0##*/} [options] [query]
    ${0##*/} [query] [options]

${C_WHITE}Commands:${C_RESET}
    ${C_DIM}(default)${C_RESET}     Search and play

${C_WHITE}Options:${C_RESET}
    ${C_CYAN}-s${C_RESET}, ${C_CYAN}--search${C_RESET}       Search movies/series
    ${C_CYAN}-t${C_RESET}, ${C_CYAN}--trending${C_RESET}     Show trending content
    ${C_CYAN}-r${C_RESET}, ${C_CYAN}--recent${C_RESET}       Show recently added
    ${C_CYAN}-b${C_RESET}, ${C_CYAN}--browse${C_RESET}       Browse a collection
    ${C_CYAN}-i${C_RESET}, ${C_CYAN}--info${C_RESET}         Show info only (no play)
    ${C_CYAN}-d${C_RESET}, ${C_CYAN}--download${C_RESET}     Download instead of playing
    ${C_CYAN}-D${C_RESET}, ${C_CYAN}--download-all${C_RESET} Download all qualities
    ${C_CYAN}-p${C_RESET}, ${C_CYAN}--player${C_RESET}       Specify player (mpv, iina, vlc)
    ${C_CYAN}-V${C_RESET}, ${C_CYAN}--version${C_RESET}      Show version
    ${C_CYAN}-h${C_RESET}, ${C_CYAN}--help${C_RESET}         Show this help
    ${C_DIM}--rofi${C_RESET}           Use rofi instead of fzf
    ${C_DIM}--dmenu${C_RESET}          Use dmenu instead of fzf
    ${C_DIM}--no-detach${C_RESET}      Don't detach player
    ${C_DIM}--download-dir${C_RESET}   Set download directory

${C_WHITE}Examples:${C_RESET}
    ${C_GRAY}${0##*/} batman${C_RESET}
    ${C_GRAY}${0##*/} -s "death of robin hood"${C_RESET}
    ${C_GRAY}${0##*/} -t movies${C_RESET}
    ${C_GRAY}${0##*/} -d euphoria${C_RESET}
    ${C_GRAY}${0##*/} -b bolly_movies${C_RESET}

EOF
    exit 0
}

version_info() {
    printf "%s\n" "$version_number"
    exit 0
}

# ─── Deps ───────────────────────────────────────────────────────────────────

dep_ch() {
    command -v "$1" >/dev/null || die "Program $1 not found. Please install it."
}

dep_ch_failover() {
    [ -z "$1" ] && return 1
    prog=$(printf "%s" "$1" | cut -d "," -f 1)
    rest=$(printf "%s" "$1" | cut -s -d "," -f 2-)
    command -v "$prog" >/dev/null 2>&1 && printf "%s" "$prog" && return 0
    dep_ch_failover "$rest"
}

_exit_code=0

cleanup() {
    [ -t 1 ] && tput sgr0 2>/dev/null
    rm -f "$tmpfile" "$tmpfile2" "$tmpfile3"
    kill "$_spinner_pid" 2>/dev/null
    exit "$_exit_code"
}

on_sigint() {
    _exit_code=130
    cleanup
}

# ─── API ────────────────────────────────────────────────────────────────────

api_fetch() {
    # $1 = endpoint, $2 = output file
    $curl_exe -sf "${API}${1}" -o "$2" || die "API request failed: ${1}"
}

# ─── URL resolution ─────────────────────────────────────────────────────────

resolve_stream_url() {
    _workers_url="$1"
    _vcloud_val="$(printf "%s" "$_workers_url" | sed -n 's/.*vcloud=//p' | sed 's/[& ].*//')"
    [ -z "$_vcloud_val" ] && printf "%s" "$_workers_url" && return

    _base="$(printf "%s" "$_workers_url" | sed 's/?.*//' | sed 's|/$||')"
    _tokens_json="$($curl_exe -sf "${_base}/api/links?vcloud=${_vcloud_val}")"
    [ -z "$_tokens_json" ] && printf "%s" "$_workers_url" && return

    _type="$(printf "%s" "$_tokens_json" | grep -oP '"tokens":\{"\K[^"]+' | head -n 1)"
    _ts="$(printf "%s" "$_tokens_json" | sed -n "s/.*\"${_type}\":{\"ts\":\"\([^\"]*\)\".*/\1/p")"
    _sig="$(printf "%s" "$_tokens_json" | sed -n "s/.*\"${_type}\":{[^}]*\"sig\":\"\([^\"]*\)\".*/\1/p")"

    [ -z "$_type" ] && printf "%s" "$_workers_url" && return

    _go_url="${_base}/go?type=${_type}&vcloud=${_vcloud_val}&ts=${_ts}&sig=${_sig}"
    _real_url="$($curl_exe -sIL "$_go_url" 2>/dev/null | grep -i '^location:' | tail -1 | sed 's/^[Ll]ocation: *//;s/\r//')"
    [ -n "$_real_url" ] && printf "%s" "$_real_url" || printf "%s" "$_workers_url"
}

# ─── Parse links ────────────────────────────────────────────────────────────

# Input: raw links text. Output: lines of url|desc|size to stdout
# Format: URL, Link2, Link3, Link4, Link5, Link6, Link7, Description, Size
parse_links() {
    printf "%s" "$1" | while IFS= read -r line; do
        line="$(printf "%s" "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        [ -z "$line" ] && continue
        url="$(printf "%s" "$line" | cut -d',' -f1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        size="$(printf "%s" "$line" | rev | cut -d',' -f1 | rev | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        desc="$(printf "%s" "$line" | rev | cut -d',' -f2 | rev | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        printf "%s\t%s\t%s\n" "$url" "$desc" "$size"
    done
}

# Input: season text. Output: lines of "ep_num\turl\tqual\tsize" to stdout
# Format per line: "Episode N : URL,SIZE,QUALITY : URL,SIZE,QUALITY"
# Selects best quality per episode (last = highest)
parse_episodes() {
    printf "%s" "$1" | while IFS= read -r line; do
        line="$(printf "%s" "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        printf "%s" "$line" | grep -q '^Episode' || continue
        _ep_num="$(printf "%s" "$line" | sed 's/Episode \([0-9]*\) :.*/\1/')"
        _variants="$(printf "%s" "$line" | sed 's/Episode [0-9]* : //')"
        _best="$(printf "%s" "$_variants" | sed 's/.* : //' | tail -1)"
        _url="$(printf "%s" "$_best" | cut -d',' -f1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        _size="$(printf "%s" "$_best" | cut -d',' -f2 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        _qual="$(printf "%s" "$_best" | cut -d',' -f3 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        printf "%s\t%s\t%s\t%s\n" "$_ep_num" "$_url" "$_qual" "$_size"
    done
}

# ─── Selection helpers ──────────────────────────────────────────────────────

# Present items from JSON file via fzf/nth, write selected JSON to tmpfile2
select_item() {
    _count=$(jq 'length' "$tmpfile")
    [ "$_count" -eq 0 ] && warn "No results found." && return 1

    if [ "$_count" -eq 1 ]; then
        jq '.[0]' "$tmpfile" > "$tmpfile2"
        return 0
    fi

    # Build display list: "01  Title  [type]  (year)"
    jq -r 'to_entries[] | "\(.key | tostring | if length < 2 then "0" + . else . end)  \(.value.title // "Untitled")  [\(.value.contentType // "movie")]  (\(.value.date // "" | .[0:4]))"' "$tmpfile" > "$tmpfile3"

    _selection=$(cat "$tmpfile3" | menu "Select (${_count} results): ")
    [ -z "$_selection" ] && return 1

    # Extract index from selection (first 2 digits)
    _idx=$(printf "%s" "$_selection" | head -c 2 | tr -d ' ')
    [ -z "$_idx" ] && return 1

    jq ".[${_idx}]" "$tmpfile" > "$tmpfile2"
}


# ─── Show info ──────────────────────────────────────────────────────────────

show_info() {
    [ -f "$tmpfile2" ] || die "No item selected"
    _f="$tmpfile2"

    _title=$(jq -r '.title' "$_f")
    _image=$(jq -r '.featured_image // "N/A"' "$_f")
    _type=$(jq -r '.contentType // "movie"' "$_f")
    _slug=$(jq -r '.url_slug // "N/A"' "$_f")
    _date=$(jq -r '.date // "N/A"' "$_f")
    _cats=$(jq -r '.categories // "N/A"' "$_f")
    _year=$(printf "%s" "$_date" | head -c 4)

    printf "\n"
    printf "  ${C_CYAN}${C_BOLD}%-50s${C_RESET} ${C_DIM}%s${C_RESET}\n" "$_title" "$_type"
    printf "  ${C_DIM}$(printf '─%.0s' {1..50})${C_RESET}\n"
    printf "\n"
    printf "  ${C_DIM}Date:${C_RESET}      %s\n" "$_date"
    printf "  ${C_DIM}Slug:${C_RESET}      %s\n" "$_slug"
    printf "\n"

    # Categories as badges
    if [ "$_cats" != "N/A" ] && [ -n "$_cats" ]; then
        printf "  ${C_DIM}Categories:${C_RESET}\n"
        printf "%s" "$_cats" | tr ',' '\n' | sed 's/^  */    /' | while IFS= read -r _cat; do
            printf "    ${C_MAGENTA}◆${C_RESET} %s\n" "$_cat"
        done
    fi

    # Download links
    _links=$(jq -r '.links // empty' "$_f")
    if [ -n "$_links" ]; then
        printf "\n"
        printf "  ${C_DIM}Available:${C_RESET}\n"
        parse_links "$_links" | while IFS='	' read -r _url _desc _size; do
            _qual=$(printf "%s" "$_desc" | grep -oE '[0-9]+p' | head -1)
            [ -z "$_qual" ] && _qual="alt"
            printf "    ${C_GREEN}▶${C_RESET} %-12s ${C_DIM}%s${C_RESET}\n" "$_qual" "$_size"
        done
    fi

    # Seasons for series
    _i=1
    while [ "$_i" -le 10 ]; do
        _season=$(jq -r ".season_${_i} // empty" "$_f")
        if [ -n "$_season" ]; then
            _ep_count=$(printf "%s" "$_season" | grep -c '^Episode' || echo 0)
            printf "\n"
            printf "  ${C_CYAN}Season %s${C_RESET} ${C_DIM}(%s episodes)${C_RESET}\n" "$_i" "$_ep_count"
            printf "%s" "$_season" | head -3 | sed 's/^/    /'
            [ "$_ep_count" -gt 3 ] && printf "    ${C_DIM}... and %s more${C_RESET}\n" "$((_ep_count - 3))"
        fi
        _i=$(( _i + 1 ))
    done

    printf "\n"
}

# ─── Action Menu ─────────────────────────────────────────────────────────────

# Check if item is series (has season data)
is_series() {
    [ -f "$tmpfile2" ] || return 1
    _s=$(jq -r '.season_1 // empty' "$tmpfile2")
    [ -n "$_s" ] && return 0 || return 1
}

# Get available seasons count
season_count() {
    [ -f "$tmpfile2" ] || { echo 0; return; }
    _count=0
    _i=1
    while [ "$_i" -le 20 ]; do
        _s=$(jq -r ".season_${_i} // empty" "$tmpfile2")
        [ -n "$_s" ] && _count="$_i"
        _i=$(( _i + 1 ))
    done
    echo "$_count"
}

# Get episode URL by index from parsed episodes
get_episode_url() {
    _idx="$1"
    printf "%s" "$_ep_list" | sed -n "${_idx}p" | cut -f2
}

# Get episode display name
get_episode_name() {
    _idx="$1"
    printf "%s" "$_ep_list" | sed -n "${_idx}p" | awk -F'\t' '{printf "Episode %s (%s, %s)", $1, $3, $4}'
}

# Episode controller loop
episode_loop() {
    _title="$1"
    _ep_total=$(printf "%s" "$_ep_list" | wc -l | tr -d ' ')

    while true; do
        _ep_name=$(get_episode_name "$_cur_ep")
        _ep_url=$(get_episode_url "$_cur_ep")
        [ -z "$_ep_url" ] && break

        _resolved=$(resolve_stream_url "$_ep_url")
        [ -z "$_resolved" ] && warn "Failed to resolve URL." && break

        info "Playing [${_cur_ep}/${_ep_total}]: $_title - $_ep_name"
        play_url "$_resolved" "$_title - $_ep_name"
        # Wait for player to finish
        if [ "$no_detach" = 0 ]; then
            _mpid=$(pgrep -f "mpv.*$(printf '%s' "$_resolved" | head -c 50)" 2>/dev/null | head -1)
            [ -n "$_mpid" ] && wait "$_mpid" 2>/dev/null
        fi

        # Build control menu
        printf "" > "$tmpfile3"
        [ "$_cur_ep" -gt 1 ] && printf "← Previous\n" >> "$tmpfile3"
        printf "↻ Replay\n" >> "$tmpfile3"
        [ "$_cur_ep" -lt "$_ep_total" ] && printf "→ Next\n" >> "$tmpfile3"
        printf "✕ Back\n" >> "$tmpfile3"

        _ctrl=$(cat "$tmpfile3" | menu "[${_cur_ep}/${_ep_total}] ")
        [ -z "$_ctrl" ] && break

        case "$_ctrl" in
            *Next)     _cur_ep=$(( _cur_ep + 1 )) ;;
            *Previous) _cur_ep=$(( _cur_ep - 1 )) ;;
            *Replay)   ;; # loop again with same ep
            *Back)     break ;;
        esac
    done
}

prompt_action() {
    _title=$(jq -r '.title' "$tmpfile2")

    # ─── Series/Anime flow ───
    if is_series; then
        _sc=$(season_count)
        [ "$_sc" -eq 0 ] && warn "No season data found." && return 1

        if [ "$_sc" -eq 1 ]; then
            _sn=1
        else
            printf "" > "$tmpfile3"
            _i=1
            while [ "$_i" -le "$_sc" ]; do
                printf "Season %s\n" "$_i" >> "$tmpfile3"
                _i=$(( _i + 1 ))
            done
            _season_pick=$(cat "$tmpfile3" | menu "Seasons for ${_title}: ")
            [ -z "$_season_pick" ] && return 1
            _sn=$(printf "%s" "$_season_pick" | grep -o '[0-9]*')
        fi

        # Get episode list for selected season
        _season_text=$(jq -r ".season_${_sn} // empty" "$tmpfile2")
        [ -z "$_season_text" ] && warn "No season data." && return 1
        _ep_list=$(parse_episodes "$_season_text")
        [ -z "$_ep_list" ] && warn "No episodes found." && return 1

        _ep_total=$(printf "%s" "$_ep_list" | wc -l | tr -d ' ')

        # Episode selection
        if [ "$_ep_total" -eq 1 ]; then
            _cur_ep=1
        else
            printf "" > "$tmpfile3"
            printf "%s" "$_ep_list" | while IFS='	' read -r _num _url _qual _size; do
                printf "%-12s  %s  %s\n" "Ep $_num" "$_qual" "$_size" >> "$tmpfile3"
            done
            _ep_pick=$(cat "$tmpfile3" | menu "Episodes (Season $_sn): ")
            [ -z "$_ep_pick" ] && return 1
            _cur_ep=$(printf "%s" "$_ep_pick" | grep -oE '^Ep [0-9]+' | grep -oE '[0-9]+')
        fi

        episode_loop "$_title"
        return
    fi

    # ─── Movie flow ───
    _links=$(jq -r '.links // empty' "$tmpfile2")
    [ -z "$_links" ] && warn "No downloadable links." && return 1

    _parsed="$(parse_links "$_links")"
    _best_url=$(printf "%s" "$_parsed" | tail -1 | cut -f1)

    _resolved=$(resolve_stream_url "$_best_url")
    [ -z "$_resolved" ] && warn "Failed to resolve URL." && return 1
    info "Playing: $_title"
    play_url "$_resolved" "$_title"
}

# ─── Player ─────────────────────────────────────────────────────────────────

play_url() {
    _url="$1"
    _name="$2"
    case "$player_function" in
        *iina*)
            if pgrep -f "IINA" >/dev/null 2>&1; then
                nohup $player_function --no-stdin --mpv-force-media-title="$_name" "$_url" >/dev/null 2>&1 &
            else
                nohup $player_function --no-stdin --keep-running --mpv-force-media-title="$_name" "$_url" >/dev/null 2>&1 &
            fi
            ;;
        *mpv*)
            if [ "$no_detach" = 0 ]; then
                nohup $player_function --force-media-title="$_name" "$_url" > /tmp/hicine.mpv.log 2>&1 &
            else
                $player_function --force-media-title="$_name" "$_url"
            fi
            ;;
        download) do_download "$_url" "$_name" ;;
        *) nohup $player_function "$_url" >/dev/null 2>&1 &
    esac
}

# ─── Download ───────────────────────────────────────────────────────────────

do_download() {
    _url="$1"
    _name="$2"
    [ -z "$_url" ] && die "No URL to download"
    _safe="$(printf "%s" "$_name" | sed 's/[^a-zA-Z0-9 ._-]//g' | tr ' ' '_')"
    _filepath="${download_dir}/${_safe}.mp4"

    [ -f "$_filepath" ] && warn "Already exists: $_filepath" && return 0

    info "Downloading: $_safe"

    if command -v yt-dlp >/dev/null 2>&1; then
        yt-dlp --no-part -o "$_filepath" "$_url" && ok "Saved: $_filepath" && return 0
    fi
    if command -v ffmpeg >/dev/null 2>&1; then
        ffmpeg -y -i "$_url" -c copy "$_filepath" 2>/dev/null && ok "Saved: $_filepath" && return 0
    fi
    curl -L --progress-bar -o "$_filepath" "$_url" && ok "Saved: $_filepath"
}

# ─── Commands ───────────────────────────────────────────────────────────────

cmd_search() {
    _query="$1"
    [ -z "$_query" ] && die "Missing search query"
    _encoded=$(printf '%s' "$_query" | sed 's/ /+/g')
    info "Searching: $_query"
    api_fetch "/api/search/${_encoded}" "$tmpfile"
    select_item || return 0
    show_info
    [ "$info_only" -eq 0 ] && prompt_action
}

cmd_trending() {
    _type="${1:-}"
    _endpoint="/api/trending"
    [ -n "$_type" ] && _endpoint="/api/trending/${_type}"
    info "Loading trending ${_type:-content}..."
    api_fetch "$_endpoint" "$tmpfile"
    select_item || return 0
    show_info
    [ "$info_only" -eq 0 ] && prompt_action
}

cmd_recent() {
    _type="${1:-}"
    _endpoint="/api/recent"
    [ -n "$_type" ] && _endpoint="/api/recent/${_type}"
    info "Loading recent ${_type:-content}..."
    api_fetch "$_endpoint" "$tmpfile"
    select_item || return 0
    show_info
    [ "$info_only" -eq 0 ] && prompt_action
}

cmd_browse() {
    _collection="$1"
    [ -z "$_collection" ] && die "Missing collection name"
    info "Loading $_collection..."
    api_fetch "/api/${_collection}" "$tmpfile"
    # Unwrap { data: [...] } if present
    if jq -e '.data' "$tmpfile" >/dev/null 2>&1; then
        jq '.data' "$tmpfile" > "${tmpfile}.tmp"
        mv "${tmpfile}.tmp" "$tmpfile"
    fi
    select_item || return 0
    show_info
    [ "$info_only" -eq 0 ] && prompt_action
}

# ─── Main ───────────────────────────────────────────────────────────────────

# Config
API="https://api.hicine.sbs"
download_dir="${HICINE_DOWNLOAD_DIR:-$HOME/Movies}"
no_detach="${HICINE_NO_DETACH:-0}"
info_only=0
menu_program="${HICINE_MENU:-fzf}"
menu_extra_flags="${HICINE_MENU_FLAGS:-}"

# Tmp files
tmpfile=$(mktemp /tmp/hicine.XXXXXX)
tmpfile2=$(mktemp /tmp/hicine.XXXXXX)
tmpfile3=$(mktemp /tmp/hicine.XXXXXX)
trap cleanup EXIT
trap on_sigint INT
trap cleanup HUP TERM

# Curl
curl_exe="curl"
command -v curl >/dev/null 2>&1 || die "curl not found"

# Player detection
case "$(uname -s)" in
    Darwin*)
        player_function="${HICINE_PLAYER:-$(dep_ch_failover "iina,/Applications/IINA.app/Contents/MacOS/iina-cli,mpv")}"
        ;;
    *)
        player_function="${HICINE_PLAYER:-$(dep_ch_failover "mpv,vlc")}"
        ;;
esac

# Non-terminal fallback
if [ ! -t 0 ]; then
    command -v dmenu >/dev/null && menu_program=dmenu
    command -v rofi >/dev/null && menu_program=rofi
fi

# Parse args
search_mode=""
query=""
while [ $# -gt 0 ]; do
    case "$1" in
        -s|--search)      search_mode="search" ;;
        -t|--trending)    search_mode="trending" ;;
        -r|--recent)      search_mode="recent" ;;
        -b|--browse)      search_mode="browse"; shift; _browse_col="$1"; [ -z "$_browse_col" ] && die "Missing collection name for -b" ;;
        -i|--info)        search_mode="info"; info_only=1 ;;
        -d|--download)    player_function="download" ;;
        -D|--download-all) search_mode="download_all" ;;
        -p|--player)      shift; player_function="$1" ;;
        -V|--version)     version_info ;;
        -h|--help)        help_info ;;
        --rofi)           menu_program="rofi" ;;
        --dmenu)          menu_program="dmenu" ;;
        --no-detach)      no_detach=1 ;;
        --download-dir)   shift; download_dir="$1" ;;
        help)             help_info ;;
        version)          version_info ;;
        trending|recent|browse|search|info)
            [ -z "$search_mode" ] && search_mode="$1" || query="$(printf '%s' "$query $1" | sed 's|^ ||')"
            ;;
        *)                query="$(printf '%s' "$query $1" | sed 's|^ ||')" ;;
    esac
    shift
done

# Deps check
dep_ch "sed"
dep_ch "grep"
dep_ch "jq"
dep_ch "$menu_program"
case "$player_function" in
    download) dep_ch_failover "yt-dlp,ffmpeg" >/dev/null || die "Need yt-dlp or ffmpeg for downloads" ;;
    *mpv*) dep_ch mpv ;;
    *iina*) ;; # don't check on macOS if not available
    *) dep_ch "$player_function" ;;
esac

# Default to search
[ -z "$search_mode" ] && search_mode="search"

# Run command
case "$search_mode" in
    search)
        while [ -z "$query" ]; do
            printf "\33[2K\r${C_CYAN}${C_BOLD}  ▸ ${C_RESET}" && read -r query
        done
        cmd_search "$query"
        ;;
    trending)  cmd_trending "$query" ;;
    recent)    cmd_recent "$query" ;;
    browse)    cmd_browse "$_browse_col" ;;
    info)
        [ -z "$query" ] && die "Missing query for info"
        cmd_search "$query"
        ;;
    download_all)
        [ -z "$query" ] && die "Missing query"
        cmd_search "$query"
        [ ! -f "$tmpfile2" ] && return 0 2>/dev/null || exit 0
        _links=$(jq -r '.links // empty' "$tmpfile2")
        [ -z "$_links" ] && die "No links found"
        _parsed="$(parse_links "$_links")"
        _count=$(printf "%s" "$_parsed" | wc -l | tr -d ' ')
        printf "\n  ${C_YELLOW}Download ${_count} quality variants?${C_RESET} [y/N] "
        read -r _yn
        [ "$_yn" != "y" ] && [ "$_yn" != "Y" ] && exit 0
        mkdir -p "$download_dir"
        _safe="$(jq -r '.title' "$tmpfile2" | sed 's/[^a-zA-Z0-9 ._-]//g' | tr ' ' '_')"
        printf "%s" "$_parsed" | while IFS='	' read -r _url _desc _size; do
            _qual=$(printf "%s" "$_desc" | grep -oE '[0-9]+p' | head -1)
            [ -z "$_qual" ] && _qual="alt"
            do_download "$_url" "${_safe}_${_qual}"
        done
        ;;
esac

[ "$player_function" = "download" ] && exit 0

rm -f "$tmpfile" "$tmpfile2" "$tmpfile3"
