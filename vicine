version_info() {
    printf "%s\n" "$version_number"
    exit 0
}

# ─── Deps ───────────────────────────────────────────────────────────────────

dep_ch() {
    command -v "$1" >/dev/null || die "Program $1 not found. Please install it."
}

dep_ch_failover() {
    [ -z "$1" ] && return 1
    prog=$(printf "%s" "$1" | cut -d "," -f 1)
    rest=$(printf "%s" "$1" | cut -s -d "," -f 2-)
    command -v "$prog" >/dev/null 2>&1 && printf "%s" "$prog" && return 0
    dep_ch_failover "$rest"
}

_exit_code=0

cleanup() {
    # preserve the code we're exiting with (die/player rc on_sigint) — the
    # trap fires on any exit and must not flatten everything to 0
    _rc=$?
    [ "$_exit_code" = 0 ] && _exit_code="$_rc"
    [ -t 1 ] && tput sgr0 2>/dev/null
    rm -f "$tmpfile" "$tmpfile2" "$tmpfile3" "$tmpfile4" "${tmpfile}.tmp" "${tmpfile3}.pre"
    exit "$_exit_code"
}

on_sigint() {
    _exit_code=130
    warn "Interrupted."
    cleanup
}

# cleanup alone can't do this: in a HUP/TERM trap $? is the last command's
# status (normally 0), so a killed script reported success.
on_sighup()  { _exit_code=129; cleanup; }
on_sigterm() { _exit_code=143; cleanup; }

# ─── API ────────────────────────────────────────────────────────────────────

api_fetch() {
    # $1 = endpoint, $2 = output file
    # bounded: provider_chain can only fire on curl FAILURE, so an unbounded
    # request hangs the whole interactive search instead of falling through
    $curl_exe -sf --max-time 20 "${API}${1}" -o "$2" || die "API request failed: ${1}"
}

# ─── URL resolution ─────────────────────────────────────────────────────────

resolve_stream_url() {
    _workers_url="$1"
    _vcloud_val="$(printf "%s" "$_workers_url" | sed -n 's/.*vcloud=//p' | sed 's/[& ].*//')"
    if [ -z "$_vcloud_val" ]; then
        # ?vcloud= present but empty → dead API placeholder; direct URLs
        # (no vcloud at all) still pass through
        printf "%s" "$_workers_url" | grep -q 'vcloud=' && return 1
        printf "%s" "$_workers_url"
        return 0
    fi

    _base="$(printf "%s" "$_workers_url" | sed 's/?.*//' | sed 's|/$||')"
    _tokens_json=""
    _attempt=1
    while [ "$_attempt" -le 5 ]; do
        _tokens_json="$($curl_exe -sf --max-time 10 "${_base}/api/links?vcloud=${_vcloud_val}")"
        printf "%s" "$_tokens_json" | grep -q '"tokens":{}' || [ -z "$_tokens_json" ] || break
        _attempt=$(( _attempt + 1 ))
        sleep 0.5
    done
    [ -z "$_tokens_json" ] && printf "%s" "$_workers_url" && return

    _type="$(printf "%s" "$_tokens_json" | sed -n 's/.*"tokens":{"\([^"]*\)".*/\1/p')"
    _ts="$(printf "%s" "$_tokens_json" | sed -n "s/.*\"${_type}\":{\"ts\":\"\([^\"]*\)\".*/\1/p")"
    _sig="$(printf "%s" "$_tokens_json" | sed -n "s/.*\"${_type}\":{[^}]*\"sig\":\"\([^\"]*\)\".*/\1/p")"

    [ -z "$_type" ] && printf "%s" "$_workers_url" && return

    _go_url="${_base}/go?type=${_type}&vcloud=${_vcloud_val}&ts=${_ts}&sig=${_sig}"
    _real_url="$($curl_exe -sIL --max-time 10 "$_go_url" 2>/dev/null | grep -i '^location:' | tail -1 | sed 's/^[Ll]ocation: *//;s/\r//')"
    [ -n "$_real_url" ] && printf "%s" "$_real_url" || printf "%s" "$_workers_url"
}

# ─── Parse links ────────────────────────────────────────────────────────────

# Input: raw links text. Output: lines of url|desc|size to stdout
# Format: URL, Link2, Link3, Link4, Link5, Link6, Link7, Description, Size
# Note: printf "%s\n" — command substitution strips trailing newlines, which
# would silently drop the last line via `while read`.
parse_links() {
    printf "%s\n" "$1" | while IFS= read -r line; do
        line="$(printf "%s" "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        [ -z "$line" ] && continue
        # Drop the fixed mid-link placeholder fields (Link2..Link7) so they can't be
        # mistaken for data. The line is then "URL, Description, Size" — the URL
        # itself is expected to be comma-free, hence cut -d',' -f1 below.
        line="$(printf "%s" "$line" | sed 's/, *Link[0-9] *//g')"
        url="$(printf "%s" "$line" | cut -d',' -f1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        _rest="$(printf "%s" "$line" | cut -d',' -f2- | sed 's/^[[:space:]]*//')"
        [ -z "$_rest" ] && continue
        size="$(printf "%s" "$_rest" | rev | cut -d',' -f1 | rev | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        desc="$(printf "%s" "$_rest" | rev | cut -d',' -f2- | rev | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        printf "%s\t%s\t%s\n" "$url" "$desc" "$size"
    done
}

# Input: season text. Output: lines of "ep_num\turl\tqual\tsize" to stdout
# Format per line: "Episode N : URL,SIZE,QUALITY : URL,SIZE,QUALITY"
# Selects best quality per episode (last = highest) unless $2 given (e.g. 720p)
parse_episodes() {
    _want="${2:-}"
    printf "%s\n" "$1" | while IFS= read -r line; do
        line="$(printf "%s" "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        printf "%s" "$line" | grep -q '^Episode' || continue
        # skip dead stub entries
        printf "%s" "$line" | grep -q 'vcloud=empty' && continue
        _ep_num="$(printf "%s" "$line" | sed 's/Episode \([0-9]*\) :.*/\1/')"
        # normalize "03" → "3" so -e 3 matches
        _ep_num="$(printf "%s" "$_ep_num" | sed 's/^0*\(.\)/\1/')"
        _variants="$(printf "%s" "$line" | sed 's/Episode [0-9]* : //')"
        _best="$(printf "%s" "$_variants" | sed 's/.* : //' | tail -1)"
        if [ -n "$_want" ]; then
            _match=$(printf "%s" "$_variants" | sed 's/ : /\n/g' | awk -F',' -v w="$_want" '{q=$NF; gsub(/^[ \t]+|[ \t]+$/, "", q); if (tolower(q)==tolower(w)) print}' | tail -1)
            [ -n "$_match" ] && _best="$_match"
        fi
        _url="$(printf "%s" "$_best" | cut -d',' -f1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        _rest="$(printf "%s" "$_best" | cut -d',' -f2-)"
        _qual="$(printf "%s" "$_rest" | rev | cut -d',' -f1 | rev | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        _size="$(printf "%s" "$_rest" | rev | cut -d',' -f2- | rev | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        printf "%s\t%s\t%s\t%s\n" "$_ep_num" "$_url" "$_qual" "$_size"
    done
}

# Decode common HTML entities in titles/headers
hdec() {
    sed "s/&#0*39;/'/g; s/&#x27;/'/g; s/&quot;/\"/g; s/&amp;/\&/g"
}

# Percent-encode a string for use in a URL (spaces, &, #, /, etc.)
henc() {
    printf '%s' "$1" | jq -sRr '@uri'
}

# Filename-safe form of a title (canonical helper; was inline at the
# call sites)
sanitize() {
    # strip only filesystem-hostile chars so non-Latin titles (Hindi,
    # Japanese, ...) keep their script; degenerate all-hostile titles
    # fall back to a stable numeric name instead of an empty ".mp4"
    _t="$(printf "%s" "$1" | sed 's|[/\\*?"<>|]||g' | tr ' ' '_')"
    [ -n "$_t" ] || _t="vicine_$(printf '%s' "$1" | cksum | cut -d' ' -f1)"
    printf '%s' "$_t"
}

# Parsed "url\tdesc\tsize" lines -> resolved stream URL, walking candidates
# until one serves actual media. Order: requested quality first, then the
# rest by resolution (best first). A source's best variant can be a dead
# bucket entry or an HTML page while a lesser one still plays — the blind
# pick made -q best play a 404 (Loving 2016: 1080p dead, 720p/480p alive).
movie_playable() { # parsed lines -> resolved URL (stdout), 1 = nothing alive
    printf '%s\n' "$1" |
        awk -F'\t' -v q="$quality" '
            { r = 0
              if (match(tolower($2), /[0-9]+p/)) r = substr($2, RSTART, RLENGTH-1)
              m = (q != "best" && index(tolower($2), tolower(q))) ? 0 : 1
              printf "%s\t%s\t%s\n", m, 9999 - r, $1 }' |
        sort -n | cut -f3 |
        while IFS= read -r _mu; do
            [ -n "$_mu" ] || continue
            _mr="$(resolve_stream_url "$_mu")"
            [ -n "$_mr" ] || continue
            # a 200 isn't enough: source pages serve HTML at 200 (pixeldrain
            # /u/ pages do), JSON/JSONP, and text error pages count too.
            # Body-sniff the first bytes — same reject-set _stage_ok uses —
            # instead of trusting the status code.
            _body="$(curl -s -r 0-31 --max-time 20 "$_mr" 2>/dev/null | tr -d '\000\n\t\r ' | tr '[:upper:]' '[:lower:]')"
            case "${_body:-}" in
                "") warn "Source unreachable — next quality." >&2 ;;
                \<\!doc*|\<html*|\<\?xml*|\{*|\[*)
                    warn "Source is a page, not media — next quality." >&2 ;;
                "access denied"*|"not found"*|"forbidden"*)
                    warn "Source rejected the link — next quality." >&2 ;;
                *) printf '%s' "$_mr"; exit 0 ;;
            esac
        done
}

# ─── Selection helpers ──────────────────────────────────────────────────────

# Present items from JSON file via fzf/nth, write selected JSON to tmpfile2
select_item() {
    _count=$(jq 'length' "$tmpfile" 2>/dev/null)
    case "${_count:-0}" in
        *[!0-9]*) return 1 ;;   # invalid JSON → no results ('': unreachable via ${_count:-0} -> 0)
    esac
    [ "$_count" -eq 0 ] && return 1

    # Non-interactive select-nth (e.g. -n 2) — validated before the
    # single-result auto-pick so -n 9 with one result doesn't silently play it
    if [ -n "$select_nth" ]; then
        _idx="$select_nth"
        [ "$_idx" -ge "$_count" ] 2>/dev/null && die "Selection ${_idx} out of range (0-$((_count - 1)))"
        jq ".[${_idx}]" "$tmpfile" > "$tmpfile2"
        return 0
    fi

    if [ "$_count" -eq 1 ]; then
        jq '.[0]' "$tmpfile" > "$tmpfile2"
        return 0
    fi

    # Build display list (1-based, like the anime menu): "1  Title  [type]".
    # Titles carry their own release year; the API's date is an upload
    # timestamp, so appending it showed a year that isn't the film's.
    jq -r 'to_entries[] | "\(.key + 1)  \(.value.title // "Untitled")  [\(.value.contentType // "movie")]"' "$tmpfile" | hdec > "$tmpfile3"

    _selection=$(menu "Select (${_count} results): " < "$tmpfile3") || return 2   # 2 = user cancelled
    [ -z "$_selection" ] && return 2

    # Extract first index from selection (display is 1-based, array is 0-based);
    # awk always prints a number, so the result can't be empty here
    _idx=$(printf "%s" "$_selection" | awk '{print $1-1}')

    jq ".[${_idx}]" "$tmpfile" > "$tmpfile2"
}


# ─── Show info ──────────────────────────────────────────────────────────────

show_info() {
    [ -f "$tmpfile2" ] || die "No item selected"
    _f="$tmpfile2"

    _title=$(jq -r '.title' "$_f" | hdec)
    _type=$(jq -r '.contentType // "movie"' "$_f")

    printf "\n"
    printf "  ${C_CYAN}${C_BOLD}%-50s${C_RESET} ${C_DIM}%s${C_RESET}\n" "$_title" "$_type"
    printf "  ${C_DIM}$(hr 50)${C_RESET}\n"
    printf "\n"

    _links=$(jq -r '.links // empty' "$_f")
    if [ -n "$_links" ]; then
        printf "\n"
        printf "  ${C_DIM}Available:${C_RESET}\n"
        parse_links "$_links" | while IFS='	' read -r _url _desc _size; do
            _qual=$(printf "%s" "$_desc" | grep -oE '[0-9]+p' | head -1)
            [ -z "$_qual" ] && _qual="alt"
            printf "    ${C_GREEN}▶${C_RESET} %-12s ${C_DIM}%s${C_RESET}\n" "$_qual" "$_size"
        done
    fi

    season_fields | while IFS='	' read -r _sn _season; do
        _ep_count=$(printf "%s" "$_season" | grep -c '^Episode')
        printf "\n"
        printf "  ${C_CYAN}Season %s${C_RESET} ${C_DIM}(%s episodes)${C_RESET}\n" "$_sn" "$_ep_count"
    done

    printf "\n"
}

# ─── Action Menu ─────────────────────────────────────────────────────────────

# Check if item is series (has season data) — season_count scans the same
# 1..20 fields, so reuse it instead of a second jq pass.
is_series() {
    [ -f "$tmpfile2" ] || return 1
    [ "$(season_count)" -gt 0 ]
}

# Every non-empty season_N field of the selected item, as "N<TAB>text". One
# jq call: season_count and show_info each used to spawn jq twenty times to
# scan 1..20 and hope none of them was missing.
season_fields() {
    [ -f "$tmpfile2" ] || return 1
    jq -r 'to_entries[] | select(.key | test("^season_[0-9]+$")) | select((.value // "") != "") | "\(.key[7:])\t\(.value)"' "$tmpfile2" 2>/dev/null
}

# Get available seasons count
season_count() {
    [ -f "$tmpfile2" ] || { printf '%s\n' 0; return; }
    season_fields | awk -F'\t' '$1+0 > m { m = $1+0 } END { print m+0 }'
}

# "Season 1..N" into $tmpfile3, offered as a menu. $3 = extra menu flags.
season_menu() { # count, prompt, extra flags
    printf "" > "$tmpfile3"
    _smi=1
    while [ "$_smi" -le "$1" ]; do
        printf 'Season %s\n' "$_smi" >> "$tmpfile3"
        _smi=$(( _smi + 1 ))
    done
    menu "$2" $3 < "$tmpfile3"
}

# A list on stdin rendered as "<row> <item>" — the row is what the caller maps
# back through its own list, so non-contiguous numbering still picks the right
# one. Formatting only; offer it with picker (or numbered_menu, which adds the
# menu itself).
numbered() {
    nl -w 2 | sed 's/^[[:space:]]*//' | sed 's/\t/  /'
}

# Same, but opens a menu — for pickers reached only interactively.
numbered_menu() { # prompt, list on stdin
    numbered | menu "$1" || true
}

# Get episode URL by number from parsed episodes
get_episode_url() {
    _num="$1"
    printf "%s" "$_ep_list" | awk -F'\t' -v n="$_num" '$1==n {print $2; exit}'
}

# Get episode display name by number
get_episode_name() {
    _num="$1"
    printf '%s' "$_ep_list" | awk -F '\t' -v n="$_num" '$1==n && $1 ~ /^[0-9]+$/ {printf "Episode %s (%s, %s)\n", $1, $3, $4}'
}

# Narrow "id<TAB>..." lines to the -e request (N, N-M, -1); echoes the filter
# result. Used by both -D flows (series + anime) and their confirm counts so
# the prompt can't disagree with what actually downloads.
eps_by_request() {
    _l="$1"; _r="$2"
    case "$_r" in
        "")  printf '%s\n' "$_l" ;;
        -1)  _le="$(printf '%s\n' "$_l" | tail -1 | cut -f1)"
             printf '%s\n' "$_l" | awk -F'\t' -v l="$_le" '$1==l' ;;
        *-*) _rs="${_r%%-*}"; _re="${_r#*-}"
             # %% (longest), not % (shortest): for "10--1" %- strips only "-1" and
             # leaves "10-", which awk then compares as a STRING — "2" > "10-"
             # so episodes below the start came back in the range
             [ "$_re" = "-1" ] && _re="$(printf '%s\n' "$_l" | tail -1 | cut -f1)"
             printf '%s\n' "$_l" | awk -F'\t' -v s="$_rs" -v e="$_re" '$1>=s && $1<=e' ;;
        *)   printf '%s\n' "$_l" | awk -F'\t' -v n="$_r" '$1==n' ;;
    esac
}


# ─── History ──────────────────────────────────────────────────────────────

# Record last watched position. Format: slug\ttitle\ttype\tseason\tepisode
update_history() {
    _slug="$1"; _title="$2"; _type="$3"; _season="$4"; _ep="$5"
    [ -z "$_slug" ] && return
    # `"" !=` forces a string compare: bare `$1 != s` compares numerically when
    # both look like numbers, so removing slug 005 also removed 5. The append
    # uses "" as well so the dedup key keeps awk's string semantics.
    # mktemp, not a fixed "$histfile.tmp": two copies running at once (two
    # terminals) shared that name, so the second awk truncation erased the
    # first one's new row before its mv
    _ht="$(mktemp "$histfile.tmp.XXXXXX")" || return
    awk -F '\t' -v s="$_slug" '$1 "" != s ""' "$histfile" > "$_ht" 2>/dev/null || true
    # flatten tabs/newlines in the remote title: an embedded one would forge a
    # whole extra row, and its season field reaches a jq program on read-back.
    # Done on the title alone — running the whole record through tr would eat
    # the trailing newline and break wc -l in cmd_history.
    _title="$(printf '%s' "$_title" | tr '\t\n' '  ')"
    printf "%s\t%s\t%s\t%s\t%s\n" "$_slug" "$_title" "$_type" "$_season" "$_ep" >> "$_ht"
    mv "$_ht" "$histfile"
}

cmd_history() {
    [ -f "$histfile" ] && [ -s "$histfile" ] || { warn "No watch history yet."; return 0; }
    _count=$(wc -l < "$histfile")
    printf "" > "$tmpfile3"
    awk -F'\t' '{ printf "%d  %s", NR, $2; if ($3=="series") printf "  [S%sE%s]", $4, $5; else if ($3=="anime") printf "  [Ep%s]", $5; printf "\n" }' "$histfile" | hdec >> "$tmpfile3"
    _pick=$(menu "Continue (${_count}): " < "$tmpfile3")
    [ -z "$_pick" ] && return 0
    _idx=$(printf "%s" "$_pick" | awk '{print $1+0}')
    _entry=$(sed -n "${_idx}p" "$histfile")
    resume_season=$(printf "%s" "$_entry" | cut -f4)
    resume_ep=$(printf "%s" "$_entry" | cut -f5)
    _type=$(printf "%s" "$_entry" | cut -f3)
    _slug=$(printf "%s" "$_entry" | cut -f1)
    if [ "$_type" = "series" ]; then
        api_fetch "/api/series/${_slug}" "$tmpfile2"
    elif [ "$_type" = "anime" ]; then
        anime_resume "$_slug" "$(printf "%s" "$_entry" | cut -f2)" "$resume_ep"
        resume_season=""
        resume_ep=""
        return
    else
        api_fetch "/api/movies/${_slug}" "$tmpfile2"
    fi
    show_info
    [ "$info_only" -eq 0 ] && prompt_action
    resume_season=""
    resume_ep=""
}

cmd_clear_history() {
    : > "$histfile"
    ok "History cleared."
    exit 0
}

# ─── Player ─────────────────────────────────────────────────────────────────

# Provider text reaches mpv/yt-dlp/curl as a bare positional, so a leading "--"
# is parsed as an option (mpv --script= runs Lua, yt-dlp --exec= runs a shell).
# The 401/403 probe below can't help: it only runs for http(s). So allow only
# an http(s) URL.
check_stream_url() {
    case "$1" in
        http://*|https://*) return 0 ;;
    esac
    die "Refusing non-HTTP stream URL from provider: $1"
}

play_url() {
    _url="$1"
    _name="$2"
    _ref="$3"
    check_stream_url "$_url"
    _player_pid=""   # set only when a player is backgrounded (see episode_loop wait)
    # set up front so no branch can fall through to the tail below with it
    # unset ("[: : integer expected"); a backgrounded launch always counts as
    # started, a foreground one overwrites this with the player's own code
    _pl_rc=0
    _hdr=""
    [ -n "$_ref" ] && _hdr="--http-header-fields=Referer:$_ref"
    # iina-cli drops raw mpv args placed before the URL; only --mpv-* is honored there
    _iina_hdr=""
    [ -n "$_ref" ] && _iina_hdr="--mpv-http-header-fields=Referer:$_ref"
    case "$player_function" in
        *iina*)
            if [ "$exit_after_play" = 1 ]; then
                # foreground so the player's exit code is returned
                $player_function --no-stdin --keep-running $_iina_hdr --mpv-force-media-title="$_name" "$_url"
                _pl_rc=$?
                return "$_pl_rc"
            fi
            if pgrep -f "IINA" >/dev/null 2>&1; then
                nohup $player_function --no-stdin $_iina_hdr --mpv-force-media-title="$_name" "$_url" >/dev/null 2>&1 & _player_pid=$!
            else
                nohup $player_function --no-stdin --keep-running $_iina_hdr --mpv-force-media-title="$_name" "$_url" >/dev/null 2>&1 & _player_pid=$!
            fi
            ;;
        *mpv*)
            if [ "$no_detach" = 0 ] && [ "$exit_after_play" = 0 ]; then
                nohup $player_function $_hdr --force-media-title="$_name" "$_url" > "$tmpfile4" 2>&1 & _player_pid=$!
            else
                $player_function $_hdr --force-media-title="$_name" "$_url"
                _pl_rc=$?
                return "$_pl_rc"
            fi
            ;;
        download) do_download "$_url" "$_name" "$_ref"; _pl_rc=$? ;;
        *)
            if [ "$exit_after_play" = 1 ]; then
                if [ -n "$_ref" ]; then
                    $player_function --http-referrer="$_ref" "$_url"
                else
                    $player_function "$_url"
                fi
                _pl_rc=$?
                return "$_pl_rc"
            fi
            if [ -n "$_ref" ]; then
                nohup $player_function --http-referrer="$_ref" "$_url" >/dev/null 2>&1 &
                _player_pid=$!
            else
                nohup $player_function "$_url" >/dev/null 2>&1 &
                _player_pid=$!
            fi
            _pl_rc=0
            ;;
    esac
}

# ─── Download ───────────────────────────────────────────────────────────────

# Print the first real file for a download base path, ignoring the in-flight
# staging suffixes. Any container counts, not just .mp4: a source that can't
# mux into MP4 is saved as e.g. .mkv by the container fallback in do_download.
dl_find() {
    for _f in "$1".*; do
        [ -e "$_f" ] || continue
        case "$_f" in *.part|*.ytdl) ;; *) printf '%s' "$_f"; return 0 ;; esac
    done
    return 1
}

# reject downloads that turned out to be HTML/XML/JSON/plain error pages
_stage_ok() {
    [ -s "$1" ] || { rm -f "$1"; return 1; }
    case "$(head -c 16 "$1" 2>/dev/null | tr -d '\000')" in
        # HTML/XML declarations, JSON objects/arrays, and the common plain
        # text bodies a CDN returns for a 200-with-error-page. No real media
        # container starts with any of these (ftyp/1A45DFA3/RIFF/OggS/PK are
        # what real files begin with), so nothing legitimate is rejected.
        \<\!\ *|\<\!DOCT*|\<html*|\<HTML*|\<\?xml*|\{*|\[*|"Access denied"*|"Not Found"*|"Not found"*|"Forbidden"*)
            rm -f "$1"
            return 1 ;;
    esac
    return 0
}

# bulk -D progress: one updating line per completed episode/batch. The
# parallel jobs suppress their own yt-dlp bars (they'd stomp the same
# terminal line), so this ASCII bar is the live progress there; serial
# (dl_jobs=1) shows yt-dlp's bar instead.
_dl_progress() {
    _done="$1"; _total="$2"
    [ -n "$_total" ] && [ "$_total" -gt 0 ] 2>/dev/null || return 0
    _pct=$(( _done * 100 / _total ))
    _bw=20
    _fill=$(( _done * _bw / _total ))
    _filled="$(printf '%*s' "$_fill" '' | tr ' ' '#')"
    _empty="$(printf '%*s' "$(( _bw - _fill ))" '')"
    info "[${_filled}${_empty}] ${_done}/${_total} (${_pct}%)"
}

do_download() {
    _url="$1"
    _name="$2"
    _ref="$3"
    [ -z "$_url" ] && die "No URL to download"
    check_stream_url "$_url"
    # allow relative subpaths in the name ("Title/season-1/S1E01") — kept for
    # -D organization; the full relational path is created under download_dir
    _dl_dir="$(dirname "$_name")"
    _dl_name="$(basename "$_name")"
    # sanitize() keeps "." so a ".." title survives it; _dl_dir is dirname() of
    # the UNSANITISED name, so a hostile title escapes download_dir by one level.
    case "/${_dl_dir}/" in
        */../*|*/./*) _dl_dir="" ;;
        *) [ "$_dl_dir" = "." ] && _dl_dir="" ;;
    esac
    _dl_safe="$(sanitize "$_dl_name")"
    _dl_file="${download_dir}${_dl_dir:+/${_dl_dir}}/${_dl_safe}.mp4"
    _dl_base="${_dl_file%.mp4}"
    mkdir -p "$(dirname "$_dl_file")" 2>/dev/null

    # Already exists — any container, not just .mp4 (a source that can't mux
    # into MP4 saves as e.g. .mkv via the fallback below; skip it next time)
    _dl_existing="$(dl_find "$_dl_base")"
    [ -n "$_dl_existing" ] && { warn "Already exists: $_dl_existing (delete it if a previous download was interrupted)"; return 0; }

    # Fail fast on provider-side dead links: a 1-byte range probe rejects
    # 401/403/404/410 before the yt-dlp→ffmpeg→curl chain runs; anything else
    # (timeout, range-averse server) keeps the old path. Assumes the source
    # tolerates Range; revisit if a real source 200s ranges but 403s
    # full GETs, or at the next audit pass (audit.yml opens one monthly).
    case "$_url" in
        http://*|https://*)
            if [ -n "$_ref" ]; then
                _probe="$($curl_exe -sfL -r 0-0 -o /dev/null --max-time 20 -e "$_ref" -w '%{http_code}' "$_url" 2>/dev/null)"
            else
                _probe="$($curl_exe -sfL -r 0-0 -o /dev/null --max-time 20 -w '%{http_code}' "$_url" 2>/dev/null)"
            fi
            case "$_probe" in
                401|403|404|410)
                    warn "Source rejected the link (HTTP ${_probe}) — provider-side block or dead CDN. Try again later, a different quality, or -A for anime."
                    return 1 ;;
            esac ;;
    esac

    info "Downloading: $_dl_safe"

    # Stage to $_dl_file.part and rename on success, so an interrupted
    # download can never leave a partial file that looks complete. yt-dlp does
    # its own single-level .part staging + resume when given the final path.
    _pt="${_dl_file}.part"
    # progress bars only for single, serial downloads. Parallel bulk runs
    # (dl_jobs>1) have several yt-dlp bars repainting one terminal line and
    # stampeding each other; the script's own Downloading/Saved lines give
    # the feedback there instead.
    _yt="--no-warnings --quiet"
    if [ -n "$quiet_dl" ]; then _yt="$_yt --no-progress"; else _yt="$_yt --progress"; fi
    # check_stream_url above already refused anything that is not http(s), so
    # there is no local-manifest branch here — the URL is used as-is
    if command -v yt-dlp >/dev/null 2>&1; then
        if [ -n "$_ref" ]; then
            yt-dlp $_yt --no-playlist --referer "$_ref" --no-skip-unavailable-fragments --fragment-retries infinite -N 16 -o "$_dl_file" "$_url"
            _rc=$?
        else
            yt-dlp $_yt --no-playlist --no-skip-unavailable-fragments --fragment-retries infinite -N 16 -o "$_dl_file" "$_url"
            _rc=$?
        fi
        # user interrupt (Ctrl-C): stop here — no ffmpeg/curl re-download
        if [ "$_rc" -ge 130 ]; then
            warn "Interrupted."
            rm -f "$_dl_file"
            return "$_rc"
        fi
        if [ "$_rc" -eq 0 ] && _stage_ok "$_dl_file"; then
            ok "Saved: $_dl_file"
            return 0
        fi
        # yt-dlp occasionally finishes the download but fails its own final
        # .part→final rename (ENOENT — its rename retry only covers
        # EACCES/EINVAL), then exits non-zero with a complete .part still on
        # disk. Promote it instead of discarding a finished file: only when
        # it is substantial and not an error page.
        # wc -c, not stat -c%s: BSD/macOS stat has no -c, so the test errored
        # and this recovery never ran — the finished file was deleted below
        if [ "$_rc" -ne 0 ] && [ -s "$_pt" ] && [ "$(wc -c < "$_pt" 2>/dev/null)" -gt 10485760 ] && _stage_ok "$_pt"; then
            mv -f "$_pt" "$_dl_file" 2>/dev/null && { ok "Saved: $_dl_file (yt-dlp .part recovery)"; return 0; }
        fi
        # a source that cannot be muxed into MP4 (e.g. vp9/opus HLS) fails
        # the -o *.mp4 attempt outright — retry once letting yt-dlp pick the
        # container, then keep the real extension instead of mislabelling (#13)
        if [ "$_rc" -ne 0 ]; then
            rm -f "$_dl_file" "$_pt"
            if [ -n "$_ref" ]; then
                yt-dlp $_yt --no-playlist --referer "$_ref" --no-skip-unavailable-fragments --fragment-retries infinite -N 16 -o "$_dl_base.%(ext)s" "$_url"
            else
                yt-dlp $_yt --no-playlist --no-skip-unavailable-fragments --fragment-retries infinite -N 16 -o "$_dl_base.%(ext)s" "$_url"
            fi
            _rc=$?
            if [ "$_rc" -ge 130 ]; then warn "Interrupted."; rm -f "$_dl_base".* 2>/dev/null; return "$_rc"; fi
            _real="$(dl_find "$_dl_base")"
            if [ "$_rc" -eq 0 ] && [ -n "$_real" ] && _stage_ok "$_real"; then
                _dl_file="$_real"
                ok "Saved: $_dl_file"
                return 0
            fi
            rm -f "$_dl_base".* 2>/dev/null
        fi
        rm -f "$_dl_file"
    fi
    # fallbacks don't resume — start clean
    rm -f "$_pt" "$_pt.part"
    if command -v ffmpeg >/dev/null 2>&1; then
        if [ -n "$_ref" ]; then
            ffmpeg -y -extension_picky 0 -loglevel error -headers "Referer: $_ref\r\n" -i "$_url" -c copy "$_pt" 2>/dev/null
            _rc=$?
        else
            ffmpeg -y -extension_picky 0 -loglevel error -i "$_url" -c copy "$_pt" 2>/dev/null
            _rc=$?
        fi
        if [ "$_rc" -ge 130 ]; then
            warn "Interrupted."
            rm -f "$_pt"
            return "$_rc"
        fi
        if [ "$_rc" -eq 0 ] && _stage_ok "$_pt"; then
            mv -f "$_pt" "$_dl_file" && ok "Saved: $_dl_file" && return 0
        fi
        rm -f "$_pt"
    fi
    # curl: -f makes HTTP errors (403/404) fail instead of saving the error
    # body and claiming success
    if [ -n "$_ref" ]; then
        curl -fL -e "$_ref" --progress-bar -o "$_pt" "$_url"
        _rc=$?
    else
        curl -fL --progress-bar -o "$_pt" "$_url"
        _rc=$?
    fi
    if [ "$_rc" -ge 130 ]; then
        warn "Interrupted."
        rm -f "$_pt"
        return "$_rc"
    fi
    if [ "$_rc" -eq 0 ] && _stage_ok "$_pt"; then
        mv -f "$_pt" "$_dl_file" && ok "Saved: $_dl_file" && return 0
    fi
    rm -f "$_pt"
    warn "Download failed: $_url"
    return 1
}

# ─── Episode controller ─────────────────────────────────────────────────────

episode_loop() {
    _title="$1"
    _slug="$2"
    _sn="$3"
    _ep_total=$(printf '%s\n' "$_ep_list" | tail -1 | cut -f1)
    _ep_first=$(printf '%s\n' "$_ep_list" | head -1 | cut -f1)
    _prev_pid=""

    while true; do
        _ep_name=$(get_episode_name "$_cur_ep")
        _ep_url=$(get_episode_url "$_cur_ep")
        [ -z "$_ep_url" ] && break

        _resolved=$(resolve_stream_url "$_ep_url")
        [ -z "$_resolved" ] && warn "Failed to resolve URL." && break

        # Wait for any previous player to close before starting the next one
        [ -n "$_prev_pid" ] && wait "$_prev_pid" 2>/dev/null

        if [ "$player_function" = "download" ]; then
            info "Downloading ep ${_cur_ep}/${_ep_total}: ${_title}"
        else
            info "Playing ep ${_cur_ep}/${_ep_total}: ${_title}"
        fi
        play_url "$_resolved" "$_title - $_ep_name"
        _rc=$?
        _prev_pid="$_player_pid"

        # -d/--download: do_download saved it — no menu; record a history
        # entry so downloaded titles show up under -c (dedup keeps one line)
        # -d/--download: do_download saved it — no menu, but a picked/-e range
        # still runs to its end (a bare return truncated `-d -e 3-5` to
        # episode 3 only)
        if [ "$player_function" = "download" ]; then
            [ "$_rc" -ge 130 ] && exit "$_rc"
            [ "$_rc" -eq 0 ] && update_history "${_slug:-$(jq -r '.url_slug // ""' "$tmpfile2" 2>/dev/null)}" "$_title" series "$_sn" "$_cur_ep"
            if [ -n "$_range_end" ] && [ "$_cur_ep" -lt "$_range_end" ] 2>/dev/null; then
                # next episode that EXISTS, not +1 — same as the play range
                _cur_ep="$(printf '%s\n' "$_ep_list" | awk -v n="$_cur_ep" '$1>n{print $1; exit}')"
                [ -n "$_cur_ep" ] || return "$_rc"
                continue
            fi
            return "$_rc"
        fi

        _slug="${_slug:-$(jq -r '.url_slug // ""' "$tmpfile2" 2>/dev/null)}"
        [ -n "$_slug" ] && update_history "$_slug" "$_title" series "$_sn" "$_cur_ep"

        # --exit-after-play: stop here and propagate the player's exit code
        [ "$exit_after_play" = 1 ] && exit "$_rc"

        # Auto-advance in range mode — to the next episode that EXISTS, not
        # _cur_ep+1: hicine seasons are not always 1..N (0-specials, absolute
        # numbering), so +1 could land on a number that isn't in the list. The
        # lookup then came back empty and the loop stopped mid-range silently.
        if [ -n "$_range_end" ]; then
            if [ "$_cur_ep" -lt "$_range_end" ]; then
                _cur_ep="$(printf '%s\n' "$_ep_list" | awk -v n="$_cur_ep" '$1>n{print $1; exit}')"
                [ -n "$_cur_ep" ] || break
                continue
            else
                unset _range_end
            fi
        fi

        _sc=$(season_count)
        printf "" > "$tmpfile3"
        printf "replay\n" >> "$tmpfile3"
        [ "$_cur_ep" -gt "${_ep_first:-1}" ] && printf "previous\n" >> "$tmpfile3"
        [ "$_cur_ep" -lt "$_ep_total" ] && printf "next\n" >> "$tmpfile3"
        printf "select\n" >> "$tmpfile3"
        [ "$_sc" -gt 1 ] && printf "change_season\n" >> "$tmpfile3"
        printf "change_quality\nquit\n" >> "$tmpfile3"

        _ctrl=$(menu "Playing ep ${_cur_ep}/${_ep_total}: ${_title}... " < "$tmpfile3")
        [ -z "$_ctrl" ] && break

        case "$_ctrl" in
            next)           _cur_ep="$(printf '%s\n' "$_ep_list" | awk -v n="$_cur_ep" '$1>n{print $1; exit}')" ;;
            previous)       _cur_ep="$(printf '%s\n' "$_ep_list" | awk -v n="$_cur_ep" '$1<n{l=$1} END{print l}')" ;;
            replay)         ;;
            select)
                printf "" > "$tmpfile3"
                printf '%s\n' "$_ep_list" | while IFS='	' read -r _num _url _qual _size; do
                     printf "%-12s  %s  %s\n" "Ep $_num" "$_qual" "$_size" >> "$tmpfile3"
                done
                _pick=$(menu "Select episode: " < "$tmpfile3")
                [ -n "$_pick" ] && _cur_ep=$(printf "%s" "$_pick" | grep -oE '^Ep [0-9]+' | grep -oE '[0-9]+')
                ;;
            change_quality)
                _season_text=$(jq -r ".season_${_sn} // empty" "$tmpfile2")
                # offer only the qualities this season actually lists
                _qq="$(printf "%s\n" "$_season_text" | sed -nE 's/^Episode [0-9]* : //p' | sed 's/ : /\n/g' | rev | cut -d',' -f1 | rev | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -oE '[0-9]+p' | sort -u)"
                _new_q=$(printf '%s\n' "$_qq" | pick_quality_menu "Quality: ")
                [ -n "$_new_q" ] && quality="$_new_q"
                _ep_list=$(parse_episodes "$_season_text" "$quality")
                _ep_total=$(printf '%s\n' "$_ep_list" | tail -1 | cut -f1)
                ;;
            change_season)
                _spick="$(season_menu "$_sc" "Switch season: ")"
                _sn=$(printf "%s" "$_spick" | grep -o '[0-9]*')
                [ -z "$_sn" ] && continue
                _season_text=$(jq -r ".season_${_sn} // empty" "$tmpfile2")
                _ep_list=$(parse_episodes "$_season_text" "$quality")
                # last episode NUMBER, not the count: episode_loop reads this
                # against _cur_ep, so a count breaks any non-1-based season
                _ep_total=$(printf '%s\n' "$_ep_list" | tail -1 | cut -f1)
                # first episode of the season, not 1 — absolute numbering
                # (get_episode_url 1 is empty, so episode_loop breaks)
                _cur_ep=$(printf '%s\n' "$_ep_list" | head -1 | cut -f1)
                ;;
            quit)           break ;;
            *)              break ;;
        esac
    done
}

# Whole-season dumps: some providers ship a season as one archive rather than
# per-episode links (.season_zip, "Season N : URL,Label,QUAL : URL2,...").
# Returns 0 when it handled the season, 1 when there was nothing to play.
#   $1 title, $2 slug, $3 season
play_season_zip() {
    _z_sn="$3"; _title="$1"; _slug="$2"
    _zip="$(jq -r '.season_zip // empty' "$tmpfile2")"
    [ -n "$_zip" ] || return 1
    _zip_line="$(printf "%s\n" "$_zip" | grep -E "^Season ${_z_sn} : " | head -n 1)"
    [ -n "$_zip_line" ] || return 1
    _variants="$(printf "%s" "$_zip_line" | sed 's/^Season [0-9]* : //; s/ : /\n/g')"
    # order candidates: requested quality first, then the rest (the other
    # variant uses a different workers URL — if the chosen one resolves to a
    # stale signed URL, its sibling may still be fresh)
    if [ "$quality" != "best" ]; then
        _match="$(printf "%s\n" "$_variants" | awk -F',' -v q="$quality" 'tolower($NF)==tolower(q){print}')"
        if [ -n "$_match" ]; then
            _ordered="$(printf "%s\n%s\n" "$_match" "$_variants" | awk '!seen[$0]++')"
        else
            _ordered="$_variants"
        fi
    else
        _ordered="$(printf "%s\n%s\n" "$(printf "%s\n" "$_variants" | tail -1)" "$_variants" | awk '!seen[$0]++')"
    fi
    # resolve + probe (1-byte range) each candidate: the workers resolver
    # sometimes returns a stale expired signed URL (403); drop those before
    # committing to a multi-GB download
    _resolved=""
    _label=""
    printf "%s\n" "$_ordered" > "$tmpfile3"
    while IFS= read -r _cand; do
        [ -n "$_resolved" ] && break
        _u="$(printf "%s" "$_cand" | cut -d',' -f1 | sed 's/^ *//;s/ *$//')"
        _try=1
        while [ "$_try" -le 3 ]; do
            _r="$(resolve_stream_url "$_u")"
            if [ -n "$_r" ] && curl -sfL -r 0-0 -o /dev/null --max-time 30 "$_r" 2>/dev/null; then
                _resolved="$_r"
                _label="$(printf "%s" "$_cand" | cut -d',' -f2- | sed 's/,[^,]*$//' | sed 's/^ *//;s/ *$//')"
                break
            fi
            _try=$(( _try + 1 ))
            [ "$_try" -le 3 ] && sleep 1
        done
    done < "$tmpfile3"
    if [ -z "$_resolved" ]; then
        warn "Failed to resolve season $_z_sn URL."
        return 1
    fi
    info "Playing ${_title} :: ${_label}"
    case "$_resolved" in
        *.zip|*.zip?*)
            # whole-season archive: not streamable — download it instead
            info "Season $_z_sn is a ZIP archive — downloading instead of streaming."
            _zspec="$(sanitize "$_title")"
            mkdir -p "$download_dir"
            # the label is remote text — flatten it to one sanitised path
            # component so it cannot traverse out of the download dir via .. or /
            _zlabel="$(printf "%s" "${_label##*/}" | sed 's/[^a-zA-Z0-9 ._-]//g')"
            do_download "$_resolved" "${_zspec}/season-${_z_sn}/${_zlabel}"
            _zrc=$?
            # only record it if it actually landed, like every other download path
            [ "$_zrc" -eq 0 ] && update_history "$_slug" "$_title" series "$_z_sn" 0
            return "$_zrc"
            ;;
    esac
    play_url "$_resolved" "${_title} :: ${_label}"
    _pl_rc=$?
    [ "$exit_after_play" = 1 ] && exit "$_pl_rc"
    update_history "$_slug" "$_title" series "$_z_sn" 0
    return 0
}

prompt_action() {
    _title=$(jq -r '.title' "$tmpfile2" | hdec)
    _slug=$(jq -r '.url_slug // ""' "$tmpfile2")
    _range_end=""

    # ─── Series/Anime flow ───
    if is_series; then
        _sc=$(season_count)
        [ "$_sc" -eq 0 ] && warn "No season data found." && return 1

        if [ "$_sc" -eq 1 ]; then
            _sn=1
        elif [ -n "$resume_season" ]; then
            # digits only: this is interpolated into a jq program below, and a
            # history file is attacker-writable via a title containing a newline
            case "$resume_season" in
                ''|*[!0-9]*) resume_season="" ;;
            esac
            _sn="${resume_season:-1}"
        else
            _season_pick="$(season_menu "$_sc" "Seasons for ${_title}: ")"
            [ -z "$_season_pick" ] && return 1
            _sn=$(printf "%s" "$_season_pick" | grep -o '[0-9]*')
        fi

        _season_text=$(jq -r ".season_${_sn} // empty" "$tmpfile2")
        [ -z "$_season_text" ] && warn "No season data." && return 1
        _ep_list=$(parse_episodes "$_season_text" "$quality")

        # no per-episode data: some providers ship the season as one archive
        if [ -z "$_ep_list" ]; then
            play_season_zip "$_title" "$_slug" "$_sn" || { warn "No episodes found."; return 1; }
            return 0
        fi

        # a COUNT, unlike episode_loop's _ep_total: only the "-eq 1" check
        # below reads it, and episode_loop recomputes it as a number
        _ep_total=$(printf '%s\n' "$_ep_list" | wc -l | tr -d ' ')

        # Episode selection: -e flag, resume, or interactive
        case "$requested_eps" in
            "" )
                if [ "$_ep_total" -eq 1 ]; then
                    _cur_ep=1
                elif [ -n "$resume_ep" ]; then
                    _cur_ep="$resume_ep"
                else
                    printf "" > "$tmpfile3"
                    printf '%s\n' "$_ep_list" | while IFS='	' read -r _num _url _qual _size; do
                        printf "%-12s  %s  %s\n" "Ep $_num" "$_qual" "$_size" >> "$tmpfile3"
                    done
                    picker "Episodes (Season $_sn): " "$menu_multi_flag" < "$tmpfile3" || return 1
                    _ep_pick="$_pick"
                    # min/max picked as a range. fzf -m prints in SELECTION
                    # order, not sorted, so pick 5 then 2 would give
                    # first=5 last=2 and silently drop the range
                    _ep_first=$(printf "%s" "$_ep_pick" | grep -oE '^Ep [0-9]+' | grep -oE '[0-9]+' | sort -n | head -1)
                    _ep_last=$(printf "%s" "$_ep_pick" | grep -oE '^Ep [0-9]+' | grep -oE '[0-9]+' | sort -n | tail -1)
                    _cur_ep="$_ep_first"
                    [ "$_ep_first" != "$_ep_last" ] && _range_end="$_ep_last"
                fi
                ;;
-1 )
                # latest episode
                _cur_ep="$(printf '%s\n' "$_ep_list" | tail -1 | cut -f1)"
                ;;
            *-* )
                # Range N-M (M=-1 => last episode):
                _start=$(printf "%s" "$requested_eps" | grep -oE '^(-1|[0-9]+)' | head -1)
                _end=$(printf "%s" "$requested_eps" | grep -oE '(-1|[0-9]+)$' | tail -1)
                [ "$_end" = "-1" ] && _end="$(printf "%s\n" "$_ep_list" | tail -1 | cut -f1)"
                # grep -qx over the raw rows can never match — each row is
                # "ep\turl\tqual\tsize" — so every valid -e N-M died with
                # "Episode N not found." Narrow to the number column first.
                printf "%s\n" "$_ep_list" | cut -f1 | grep -qx "$_start" || die "Episode $_start not found."
                # an out-of-range end used to truncate the run silently
                printf "%s\n" "$_ep_list" | cut -f1 | grep -qx "$_end" || die "Episode $_end not found."
                # a reversed range played from _start to the season end silently
                [ "$_start" -le "$_end" ] 2>/dev/null || die "Invalid episode range: $_start-$_end"
                _cur_ep="$_start"
                _range_end="$_end"
                ;;
            * )
                _cur_ep="$requested_eps"
                ;;
        esac
        [ -z "$_cur_ep" ] && return 1

        # validate -e target exists
        if [ -n "$requested_eps" ]; then
            if ! printf "%s\n" "$_ep_list" | awk -F'\t' -v n="$_cur_ep" '$1==n{found=1} END{exit !found}'; then
                die "Episode $_cur_ep not released in season $_sn."
            fi
        fi

        episode_loop "$_title" "$_slug" "$_sn"
        return
    fi

    # ─── Movie flow ───
    _links=$(jq -r '.links // empty' "$tmpfile2")
    if [ -z "$_links" ]; then
        # hicine has the title but no playable links — same fallback chain
        # as a search miss, so item-level dead entries don't hard-stop
        # search the original query, not the hicine item's (possibly stub)
        # title — e.g. 'xman' resolves to a dead trailer-stub entry
        provider_chain "${query:-$_title}" "title has no links"
        return
    fi

    _parsed="$(parse_links "$_links")"
    _resolved=$(movie_playable "$_parsed")
    [ -z "$_resolved" ] && warn "No playable source for $_title right now." && return 1
    if [ "$player_function" = "download" ]; then
        info "Downloading: $_title"
    else
        info "Playing: $_title"
    fi
    play_url "$_resolved" "$_title"
    _rc=$?
    # --exit-after-play: play once and return the player's exit code
    [ "$exit_after_play" = 1 ] && exit "$_rc"
    # -d/--download: do_download saved it — no control menu, but record
    # history so the download shows up under -c
    [ "$player_function" = "download" ] && {
        [ "$_rc" -ge 130 ] && exit "$_rc"
        [ "$_rc" -eq 0 ] && update_history "$_slug" "$_title" movie 0 0
        return "$_rc"
    }

    # Movie control menu loop
    while true; do
        printf "" > "$tmpfile3"
        printf "replay\n" >> "$tmpfile3"
        printf "change_quality\nquit\n" >> "$tmpfile3"
        _ctrl=$(menu "Movie: $_title... " < "$tmpfile3")
        [ -z "$_ctrl" ] && break

        case "$_ctrl" in
            replay)             _resolved=$(movie_playable "$_parsed") && [ -n "$_resolved" ] && play_url "$_resolved" "$_title" ;;
            change_quality)
                _parsed="$(parse_links "$_links")"
                _new_q=$(printf '%s\n' "$_parsed" | awk -F'\t' '{print $2}' | grep -oE '[0-9]+p' | sort -u \
                    | pick_quality_menu "Quality: ")
                [ -n "$_new_q" ] && quality="$_new_q"
                _resolved=$(movie_playable "$_parsed") && [ -n "$_resolved" ] && play_url "$_resolved" "$_title" ;;
            quit)               break ;;
            *)                  break ;;
        esac
    done

    update_history "$_slug" "$_title" movie 0 0
}

# ─── Commands ───────────────────────────────────────────────────────────────

# The single place that decides WHEN to fall through and to WHOM.
#   $1 = query, $2 = why server-1 came up empty (for the message)
# Returns 1 without touching anything when only an info card was wanted —
# -i should not launch a full playback search on a backup.
provider_chain() {
    if [ "$info_only" -eq 0 ] || [ "$download_all_mode" -eq 1 ]; then
        warn "No result on server-1 ($2) — trying anime."
        _backup_used=1
        # cmd_anime exits 0 when it comes back empty-handed, so a plain `||`
        # would look like a success. _in_chain turns cmd_anime's "no results"
        # die (which would exit the whole script) into a plain return.
        _in_chain=1
        cmd_anime "$1"
        return $?
    fi
    return 1
}

cmd_search() {
    _query="$1"
    [ -z "$_query" ] && die "Missing search query"
    _encoded=$(henc "$_query")
    info "Searching: $_query"
    if ! $curl_exe -sf --max-time 20 "${API}/api/search/${_encoded}" -o "$tmpfile"; then
        # die before the chain: an unreachable API is not the same as a miss,
        # and -i must not turn a dead endpoint into a full fallback search
        [ "$info_only" -eq 0 ] || [ "$download_all_mode" -eq 1 ] || die "Search failed: ${API} unreachable"
        provider_chain "$_query" "API unreachable"
        return
    fi
    select_item
    _sel_rc=$?
    if [ "$_sel_rc" -ne 0 ]; then
        if [ "$_sel_rc" = 2 ]; then
            # user cancelled the picker — exit quietly, no provider chain
            return 0
        fi
        provider_chain "$_query" "no results" || warn "No results found for: $_query"
        return
    fi
    [ "$info_only" -eq 1 ] && show_info
    [ "$info_only" -eq 0 ] && prompt_action
}

cmd_trending() {
    _type="${1:-}"
    _limit="?limit=${result_limit}"
    _endpoint="/api/trending"
    [ -n "$_type" ] && _endpoint="/api/trending/${_type}"
    info "Loading trending ${_type:-content}..."
    api_fetch "${_endpoint}${_limit}" "$tmpfile"
    select_item || return 0
    # -D reaches every catalogue entry point: hand the picked item to the
    # shared dody like the search/download_all case does
    if [ "$download_all_mode" = 1 ]; then
        download_all_item
        return
    fi
    [ "$info_only" -eq 1 ] && show_info
    [ "$info_only" -eq 0 ] && prompt_action
}

cmd_recent() {
    _type="${1:-}"
    _limit="?limit=${result_limit}"
    _endpoint="/api/recent"
    [ -n "$_type" ] && _endpoint="/api/recent/${_type}"
    info "Loading recent ${_type:-content}..."
    api_fetch "${_endpoint}${_limit}" "$tmpfile"
    select_item || return 0
    # -D reaches every catalogue entry point: hand the picked item to the
    # shared dody like the search/download_all case does
    if [ "$download_all_mode" = 1 ]; then
        download_all_item
        return
    fi
    [ "$info_only" -eq 1 ] && show_info
    [ "$info_only" -eq 0 ] && prompt_action
}

cmd_browse() {
    _collection="$1"
    [ -z "$_collection" ] && die "Missing collection name"
    info "Loading $_collection..."
    api_fetch "/api/$(henc "$_collection")?page=$(henc "$browse_page")&limit=$(henc "$browse_limit")" "$tmpfile"
    # Unwrap { data: [...] } if present, inject known contentType
    if jq -e '.data' "$tmpfile" >/dev/null 2>&1; then
        jq --arg ct "$browse_type" '.data | map(.contentType = $ct)' "$tmpfile" > "${tmpfile}.tmp"
        mv "${tmpfile}.tmp" "$tmpfile"
    fi
    select_item || return 0
    # -D reaches every catalogue entry point: hand the picked item to the
    # shared dody like the search/download_all case does
    if [ "$download_all_mode" = 1 ]; then
        download_all_item
        return
    fi
    [ "$info_only" -eq 1 ] && show_info
    [ "$info_only" -eq 0 ] && prompt_action
}

cmd_stats() {
    api_fetch "/rpc/stats" "$tmpfile"
    printf "\n  ${C_CYAN}${C_BOLD}VICINE catalogue${C_RESET}\n"
    printf "  ${C_DIM}$(hr 30)${C_RESET}\n"
    jq -r 'to_entries[] | "  \(.key): \(.value)"' "$tmpfile"
    printf "\n"
}

# ─── Anime provider

anidb_curl() {
    $curl_exe -sL -A "$vicine_ua" --max-time 10 "$@"
}

# search → lines "anime_id<TAB>title"
# name the bot-block: a challenge/429 body parses as zero rows and read
# "No results found." — say rate-limit instead when hianime served one.
anidb_search() {
    _q=$(henc "$1")
    _page="$(anidb_curl -w '\n%{http_code}' "${anime_search_api%"%s"}$_q")"
    _code="$(printf '%s' "$_page" | tail -1)"
    _page="$(printf '%s' "$_page" | sed '$d')"
    case "$_code" in
        403|429) die "hianime is rate-limiting this IP (HTTP ${_code}) — wait a bit and retry." ;;
    esac
    _page="$(printf '%s' "$_page" | tr '\n' ' ' | sed 's|<a href|\n<a href|g')"
    _rows="$(printf "%s" "$_page" | sed -nE 's|.*href="[^"]*/watch/[^"]+"[^>]*title="([^"]*)"[^>]*data-id="([0-9]+)".*|\2\t\1|p' | sed -e "s|&#0*39;|'|g" -e "s|&#x27;|'|g" -e 's|&quot;|"|g')"
    [ -n "$_rows" ] || {
        # a 200 challenge shell is big HTML with no /watch/ links and reads
        # like a vacuous "no results" if left unnamed
        printf '%s' "$_page" | grep -qiE 'challenge|captcha' \
            && die "hianime is bot-challenging us — wait a bit and retry."
        return 1
    }
    printf '%s\n' "$_rows"
}

# episodes for anime → lines "ep_id<TAB>ep_no" (JSON html unwrapped via jq)
# the list can be ~1MB, so give this call a longer timeout than the default 10s
anidb_episodes() {
    _page="$(anidb_curl --max-time 30 "${anime_episodes_api%"%s"}${1##*-}" | jq -r '.html // empty')"
    printf "%s" "$_page" | tr '\n' ' ' | sed 's|data-number=|\ndata-number=|g' | sed -nE 's|.*data-number="([0-9]+)"[[:space:]]*data-id="([0-9]+)".*|\2\t\1|p' | awk '!seen[$0]++'
}

# zokoanime embed: window.__P is XOR("otaku-embed-v1") of base64(JSON) → m3u8 src
ANIME_ZOKO_KEY="otaku-embed-v1"
# key byte values — a constant, computed once instead of per episode
ANIME_ZOKO_NUMS="$(printf '%s' "$ANIME_ZOKO_KEY" | od -An -v -tu1 | sed 's/^ *//')"
zoko_xor() {
    # base64 → od decimal bytes → numeric XOR with key → plaintext JSON (ASCII)
    _kn="${ANIME_ZOKO_NUMS:-$(printf '%s' "$ANIME_ZOKO_KEY" | od -An -v -tu1 | sed 's/^ *//')}"
    { base64 -d 2>/dev/null || base64 -D 2>/dev/null; } |
        od -An -v -tu1 |
        awk -v kn="$_kn" '
            function bxor(a,b,  i,r){ for(i=0;i<8;i++){ r+=((a%2)!=(b%2))*2^i; a=int(a/2); b=int(b/2) } return r }
            BEGIN { n=split(kn, kc, /[ \n]+/); idx=0 }
            { for (i=1;i<=NF;i++){ printf "%c", bxor($i, kc[(idx%n)+1]); idx++ } }'
}
zoko_src_of() {
    _page="$1"
    _blob="$(printf "%s" "$_page" | sed -nE 's|.*window\.__P="([^"]+)".*|\1|p' | head -n 1)"
    [ -z "$_blob" ] && return 1
    _dec="$(printf "%s" "$_blob" | zoko_xor)"
    [ -z "$_dec" ] && return 1
    printf "%s" "$_dec" | grep -oE '"src":"[^"]+"' | head -n 1 | sed -E 's|^"src":"||; s|"$||'
}

# CDN calls are referer-gated by hls.1embed.buzz
anime_cdn_curl() {
    $curl_exe -sL -A "$vicine_ua" -e "$anime_embed_ref" --max-time 15 "$@"
}

# m3u8 variant parser: reads a master playlist on stdin, prints "RESp>URL"
# lines (best first). Pure (sed/grep/sort/printf only) so it's testable —
# factored out of anidb_m3u8.
anime_variants() {
    _md="${1:-}"
    _res=""
    while IFS= read -r _line; do
        case "$_line" in
            *RESOLUTION=*) _res="$(printf "%s" "$_line" | sed -nE 's|.*RESOLUTION=[0-9]+x([0-9]+).*|\1|p')" ;;
        esac
        case "$_line" in
            # anchored so #EXT-X-I-FRAME-STREAM-INF lines (--URI=NNN/index.m3u8)
            # can't leak in, while absolute variant URLs still match
            [0-9]*/index.m3u8|http*index.m3u8)
                # fall back to the numeric dir when RESOLUTION is absent: relative
                # paths ("1080/index.m3u8") and absolute URLs (…/1080/index.m3u8)
                [ -z "$_res" ] && _res="$(printf '%s' "$_line" | sed -nE 's|^([0-9]+)/.*|\1|p')"
                [ -z "$_res" ] && _res="$(printf '%s' "$_line" | sed -nE 's|.*/([0-9]+)/index\.m3u8$|\1|p')"
                case "$_line" in
                    http*) _url="$_line" ;;
                    *)     _url="${_md}/$_line" ;;
                esac
                printf "%sp>%s\n" "$_res" "$_url"
                # consumed — don't leak it into the next variant
                _res="" ;;
        esac
    done | sort -rn
}

# extract m3u8 quality list ("RES>URL" lines, best first) for ep
anidb_m3u8() {
    _ep_id=$(printf "%s" "$anime_ep_maps" | sed -nE "s|^([0-9]+)\t${1}$|\1|p")
    _lang="sub"
    [ "$anime_mode" = "dub" ] && _lang="dub"
    _page="$(anidb_curl "${anime_servers_api%"%s"}${_ep_id}" | jq -r '.html // empty')"
    _hash="$(printf "%s" "$_page" | tr '\n' ' ' | sed -nE "s|.*server-item[^>]*data-type=\"${_lang}\"[^>]*data-server-name=\"ZokoAnime\"[^>]*data-hash=\"([^\"]+)\".*|\1|p" | head -n 1)"
    # only ZokoAnime embeds are decodable (MegaPlay/Vidstream need AES + segment prefix-stripping)
    [ -z "$_hash" ] && return 1
    _embed="$(printf "%s" "$_hash" | base64 -d 2>/dev/null || printf "%s" "$_hash" | base64 -D 2>/dev/null)"
    _embed_page="$(anime_cdn_curl "$_embed")"
    _master="$(zoko_src_of "$_embed_page")"
    [ -z "$_master" ] && return 1
    _mp="$(anime_cdn_curl "$_master")"
    _master_dir="$(dirname "$_master")"
    _listed="$(printf "%s\n" "$_mp" | anime_variants "$_master_dir")"
    if [ -z "$_listed" ]; then
        # no parseable variants (media playlist / single source) — play it whole
        printf "auto>%s\n" "$_master"
        return 0
    fi
    printf "%s\n" "$_listed"
}

# pick quality variant → prints chosen m3u8 line to stdout (sets nothing)
anime_pick_quality() {
    _links="$1"
    case "$quality" in
        best)  _result=$(printf "%s" "$_links" | head -n 1) ;;
        worst) _result=$(printf "%s" "$_links" | grep -E '^[0-9]{3,4}' | tail -n 1) ;;
        *)     _result=$(printf "%s" "$_links" | grep -m 1 -F "$quality") ;;
    esac
    [ -z "$_result" ] && printf "%s" "$_links" | head -n 1 || printf "%s" "$_result"
}

# play anime: resolves stream URL and reuses hicine player/history
anime_play_episode() {
    #   $1 = episode number, $2 = which time this number appears in the list
    # (default 1). A split-cour anime lists 1..13 twice under different internal
    # ids — anidb_episodes dedups the whole row, not the number — so the second
    # "1" is a DIFFERENT episode and must not land on top of the first. The
    # occurrence picks the season folder: S1E01, then S2E01.
    _ep_no="$1"
    _ep_occ="${2:-1}"
    _links="$(anidb_m3u8 "$_ep_no")" || { warn "No sources found for ep $_ep_no"; return 1; }
    [ -z "$_links" ] && { warn "No sources found for ep $_ep_no"; return 1; }
    _chosen="$(anime_pick_quality "$_links")"
    _video_link="$(printf "%s" "$_chosen" | cut -d ">" -f 2)"
    [ -z "$_video_link" ] && { warn "No valid stream for ep $_ep_no."; return 1; }
    if [ "$download_all_mode" = 1 ]; then
        _safe="$(sanitize "$anime_title")"
        _epnum=$(printf '%02d' "$_ep_no")
        # S{season}E{ep} naming — same shape the series -D flow uses, so a
        # re-run of -A -D on a partially-downloaded title skips existing files
        # and only fetches the missing episodes (gap-fill in one run).
        do_download "$_video_link" "${_safe}/season-${_ep_occ}/S${_ep_occ}E${_epnum}" "$anime_embed_ref"
        _rc=$?
        return "$_rc"
    else
        info "Playing ep ${_ep_no}: ${anime_title}"
        play_url "$_video_link" "$anime_title - Episode $_ep_no" "$anime_embed_ref"
        _rc=$?
        [ "$_rc" -eq 0 ] && update_history "$anime_id" "$anime_title" anime 0 "$_ep_no"
        [ "$exit_after_play" = 1 ] && exit "$_rc"
    fi
}

# play loop for anime.
# Globals used: anime_ep_list, anime_title, _cur_ep, _range_end
anime_play_loop() {
    while true; do
        if ! printf "%s\n" "$anime_ep_list" | grep -qx "$_cur_ep"; then
            warn "Episode $_cur_ep not available."
            break
        fi
        anime_play_episode "$_cur_ep"
        _rc=$?
        [ "$_rc" -ge 130 ] && exit "$_rc"

        # auto-advance in range mode
        if [ -n "$_range_end" ]; then
            _last="$(printf "%s\n" "$anime_ep_list" | tail -1)"
            if [ "$_cur_ep" = "$_range_end" ] || [ "$_cur_ep" = "$_last" ]; then
                unset _range_end
            else
                _cur_ep="$(printf "%s\n" "$anime_ep_list" | awk -v n="$_cur_ep" '$1==n{getline; print; exit}')"
                continue
            fi
        fi

        # control menu
        _line="$(printf "%s\n" "$anime_ep_list" | grep -n "^$_cur_ep$" | cut -d: -f1)"
        _is_first=0; [ "$_line" = "1" ] && _is_first=1
        _is_last=0; [ "$_cur_ep" = "$(printf "%s\n" "$anime_ep_list" | tail -1)" ] && _is_last=1
        printf "" > "$tmpfile3"
        printf "replay\n" >> "$tmpfile3"
        [ "$_is_first" = 0 ] && printf "previous\n" >> "$tmpfile3"
        [ "$_is_last" = 0 ] && printf "next\n" >> "$tmpfile3"
        printf "select\nchange_quality\nquit\n" >> "$tmpfile3"
        _ctrl=$(menu "Playing ep ${_cur_ep}: ${anime_title}... " < "$tmpfile3" || true)
        [ -z "$_ctrl" ] && break
        case "$_ctrl" in
            next)
                _next="$(printf "%s\n" "$anime_ep_list" | awk -v n="$_cur_ep" '$1==n{getline; print; exit}')"
                [ -n "$_next" ] && [ "$_next" != "$_cur_ep" ] && _cur_ep="$_next"
                ;;
            previous)
                _cur_ep="$(printf "%s\n" "$anime_ep_list" | awk -v n="$_cur_ep" '{if($1==n)print prev; prev=$1}')"
                ;;
            replay)   ;;
            select)
                _pick="$(printf "%s\n" "$anime_ep_list" | numbered_menu "Select episode: ")"
                [ -n "$_pick" ] && _cur_ep="$(printf "%s\n" "$anime_ep_list" | sed -n "$(printf "%s" "$_pick" | awk '{print $1+0}')p")"
                ;;
            change_quality)
                _new_q=$(printf '480p\n720p\n1080p\n2160p' | pick_quality_menu "Quality: ")
                [ -n "$_new_q" ] && quality="$_new_q"
                ;;
            quit|*)   break ;;
        esac
    done
}

# Resume an anime from history: fetch episode map for stored id, then play loop
anime_resume() {
    anime_id="$1"
    anime_title="$2"
    _ep_db="$3"
    info "Fetching episodes for $anime_title"
    anime_ep_maps="$(anidb_episodes "$anime_id")"
    if [ -z "$anime_ep_maps" ]; then
        warn "No episodes found — this history entry was written by an older provider. Clear it with 'vicine -C'."
        return 1
    fi
    anime_ep_list="$(printf "%s" "$anime_ep_maps" | cut -f 2)"
    [ -z "$anime_ep_list" ] && die "No episodes found for $anime_title."
    _cur_ep="$_ep_db"
    if ! printf "%s\n" "$anime_ep_list" | grep -qx "$_cur_ep"; then
        warn "Episode $_cur_ep not available; starting from latest."
        _cur_ep="$(printf "%s\n" "$anime_ep_list" | tail -1)"
    fi
    _range_end=""
    anime_play_loop
}

# main anime flow: search → select → episode select → play loop
cmd_anime() {
    _query="$1"
    [ -z "$_query" ] && die "Missing anime search query"

    anime_list="$(anidb_search "$_query")"
    # as the -A entry point an empty search is a hard stop; inside the fallback
    # chain it must return so the next provider gets a turn
    if [ -z "$anime_list" ]; then
        [ -n "$_in_chain" ] && return 1
        die "No results found."
    fi

    # select anime (index-prefixed non-interactive or menu)
    if [ -n "$select_nth" ]; then
        _ncount=$(printf "%s\n" "$anime_list" | wc -l | tr -d ' ')
        [ "$select_nth" -ge "$_ncount" ] 2>/dev/null && die "Selection ${select_nth} out of range (0-$((_ncount - 1)))"
        _result="$(printf "%s\n" "$anime_list" | sed -n "$((select_nth + 1))p")"
    else
        _result="$(printf "%s\n" "$anime_list" | numbered_menu "Select anime: ")"
        [ -z "$_result" ] && return 0
        _result="$(printf "%s\n" "$anime_list" | sed -n "$(printf "%s" "$_result" | awk '{print $1+0}')p")"
    fi
    [ -z "$_result" ] && die "Invalid anime selection"
    anime_id="$(printf "%s" "$_result" | cut -f 1)"
    anime_title="$(printf "%s" "$_result" | cut -f 2)"

    info "Fetching episodes for $anime_title"
    anime_ep_maps="$(anidb_episodes "$anime_id")"
    [ -z "$anime_ep_maps" ] && die "No episodes found."
    anime_ep_list="$(printf "%s" "$anime_ep_maps" | cut -f 2)"

    if [ "$info_only" -eq 1 ] && [ "$download_all_mode" -eq 0 ]; then
        _total=$(printf "%s\n" "$anime_ep_list" | wc -l | tr -d ' ')
        printf "  %s\n  %s episodes\n" "$anime_title" "$_total"
        return 0
    fi

    # Download-all mode: interactive quality + episode-range pick, then confirm
    if [ "$download_all_mode" = 1 ]; then
        # honor -e N / N-M / -1 here too, matching the hicine series -D path
        anime_ep_list="$(eps_by_request "$anime_ep_list" "$requested_eps")"
        _dl_range=""
        if [ -t 0 ]; then
            # representative qualities from the first episode's master playlist
            _ql=""
            if [ -n "$anime_ep_list" ]; then
                _qlinks="$(anidb_m3u8 "$(printf '%s\n' "$anime_ep_list" | head -1)" 2>/dev/null)"
                _ql="$(printf '%s\n' "$_qlinks" | sed -nE 's/^([0-9]+p)>.*/\1/p' | sort -u)"
            fi
            _new_q=$(printf '%s\n' "$_ql" | pick_quality_menu "Quality to download: ")
            [ -n "$_new_q" ] && quality="$_new_q"
            printf "\n  Episode range to download (e.g. 1-50, empty = all): "
            read -r _dl_range
        fi
        if [ -n "$_dl_range" ]; then
            _rstart=$(printf "%s" "$_dl_range" | grep -oE '^[0-9]+' | head -1)
            _rend=$(printf "%s" "$_dl_range" | grep -oE '[0-9]+$' | tail -1)
            [ -n "$_rstart" ] || die "Invalid episode range: $_dl_range"
            [ -n "$_rend" ] || die "Invalid episode range: $_dl_range"
            _total=$(printf "%s\n" "$anime_ep_list" | awk -v s="$_rstart" -v e="$_rend" '$1>=s && $1<=e' | wc -l | tr -d ' ')
        else
            _rstart=""
            _rend=""
            _total=$(printf "%s\n" "$anime_ep_list" | wc -l | tr -d ' ')
        fi
        # only ask on a real terminal — piped/cron runs keep the old behavior
        if [ -t 0 ]; then
            if [ "$_total" -eq 1 ]; then _ep_label2="episode"; else _ep_label2="episodes"; fi
            printf "\n  ${C_YELLOW}Download ${_total} ${_ep_label2} of '${anime_title}'?${C_RESET} [Y/n] "
            read -r _yn
            # Enter or y/Y download; anything else (n, N, junk) cancels
            case "$_yn" in
                ""|y|Y) : ;;
                *) exit 0 ;;
            esac
        fi
        # tag every row with which time its episode number appears in the list:
        # a split-cour anime repeats 1..N, and that second run of the numbers
        # must go to season-2/. One awk pass, not a rescan per episode.
        printf '%s\n' "$anime_ep_list" | awk '{ n[$1]++; print $1 "\t" n[$1] }' > "$tmpfile3"
        _jobs=0
        _waitpids=""
        _done=0
        while IFS='	' read -r _ep _occ; do
            if [ -n "$_rstart" ]; then
                [ "$_ep" -ge "$_rstart" ] 2>/dev/null || continue
                [ "$_ep" -le "$_rend" ] 2>/dev/null || continue
            fi
            if [ "$dl_jobs" -gt 1 ]; then
                quiet_dl=1
                _hist_ep="$_ep"
                ( anime_play_episode "$_ep" "$_occ" ) &
                _waitpids="$_waitpids $!"
                _jobs=$(( _jobs + 1 ))
                # wait per PID: dash's bare `wait` returns the last job's
                # status, bash/POSIX return 0 (Ctrl-C would be swallowed there)
                [ "$_jobs" -ge "$dl_jobs" ] && {
                    _rc=0
                    for _wp in $_waitpids; do wait "$_wp"; _wr=$?; [ "$_wr" -ge 130 ] && _rc="$_wr"; done
                    _done=$(( _done + _jobs ))
                    _dl_progress "$_done" "$_total"
                    _waitpids=""; _jobs=0
                    [ "$_rc" -ge 130 ] && exit "$_rc"
                }
            else
                quiet_dl=""
                anime_play_episode "$_ep" "$_occ"
                _rc=$?
                [ "$_rc" -ge 130 ] && exit "$_rc"
                [ "$_rc" -eq 0 ] && _hist_ep="$_ep"
                _done=$(( _done + 1 ))
                _dl_progress "$_done" "$_total"
            fi
        done < "$tmpfile3"
        _rc=0
        for _wp in $_waitpids; do wait "$_wp"; _wr=$?; [ "$_wr" -ge 130 ] && _rc="$_wr"; done
        _done=$(( _done + _jobs ))
        _dl_progress "$_done" "$_total"
        _waitpids=""
        [ "$_rc" -ge 130 ] && exit "$_rc"
        [ -n "${_hist_ep:-}" ] && update_history "$anime_id" "$anime_title" anime 0 "$_hist_ep"
        return
    fi

    # select episode: -e flag / range / -1 / interactive
    case "$requested_eps" in
        "" ) 
            if [ -n "$resume_ep" ]; then
                _cur_ep="$resume_ep"
            else
                printf '%s\n' "$anime_ep_list" | numbered > "$tmpfile3"
                picker "Select episode: " < "$tmpfile3" || return 0
                # the display line is "<row> <ep>"; map back through the list
                # so non-contiguous numbering (0, 13, 14, ...) plays ep 14 when
                # row 3 is picked, not row number 3 (issue #5)
                _cur_ep="$(printf "%s\n" "$anime_ep_list" | sed -n "$(printf "%s" "$_pick" | awk '{print $1+0}')p")"
            fi
            ;;
        -1 ) _cur_ep="$(printf "%s\n" "$anime_ep_list" | tail -1)" ;;
        *-* )
            _start=$(printf "%s" "$requested_eps" | grep -oE '^(-1|[0-9]+)' | head -1)
            _end=$(printf "%s" "$requested_eps" | grep -oE '(-1|[0-9]+)$' | tail -1)
            printf "%s\n" "$anime_ep_list" | grep -qx "$_start" || die "Episode $_start not found."
            _cur_ep="$_start"
            if [ "$_end" = "-1" ]; then
                _range_end="last"
            else
                printf "%s\n" "$anime_ep_list" | grep -qx "$_end" || die "Episode $_end not found."
                # a reversed range auto-advanced past _range_end and played to
                # the end of the list silently
                [ "$_start" -le "$_end" ] 2>/dev/null || die "Invalid episode range: $_start-$_end"
                _range_end="$_end"
            fi
            ;;
        * ) 
            printf "%s\n" "$anime_ep_list" | grep -qx "$requested_eps" || die "Episode $requested_eps not found."
            _cur_ep="$requested_eps"
            ;;
    esac

    # play loop (control menu)
    anime_play_loop
}

# The -D body once an item is selected into tmpfile2: walks a series by
# season, narrows by -e, and downloads everything at the chosen quality, or
# does the one-shot movie path. Shared by the search/download_all case and by
# -t/-r/-b so download-all reaches every catalogue entry point.
download_all_item() {
mkdir -p "$download_dir"

# Series: download every episode of every season at the chosen quality
if is_series; then
    _sc=$(season_count)
    [ "$_sc" -eq 0 ] && die "No season data found."
    _title="$(jq -r '.title' "$tmpfile2" | hdec)"
    _safe="$(sanitize "$_title")"

    # Interactive: let the user pick the quality and seasons first
    if [ -t 0 ]; then
        # only list qualities that actually appear in the seasons
        _ql=""
        _qi=1
        while [ "$_qi" -le "$_sc" ]; do
            _qt=$(jq -r ".season_${_qi} // empty" "$tmpfile2")
            if [ -n "$_qt" ]; then
                _qq="$(printf "%s\n" "$_qt" | sed -nE 's/^Episode [0-9]* : //p' | sed 's/ : /\n/g' | rev | cut -d',' -f1 | rev | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -oE '[0-9]+p')"
                _ql="$(printf '%s\n%s\n' "$_ql" "$_qq")"
            fi
            _qi=$(( _qi + 1 ))
        done
        _ql="$(printf '%s\n' "$_ql" | grep -oE '[0-9]+p' | sort -u)"
        _new_q=$(printf '%s\n' "$_ql" | pick_quality_menu "Quality to download: ")
        [ -n "$_new_q" ] && quality="$_new_q"
        _sel=$(season_menu "$_sc" "Seasons to download (picks = those, empty = all): " "$menu_multi_flag")
        _sel_seasons=""
        if [ -n "$_sel" ]; then
            printf "%s\n" "$_sel" | grep -o '[0-9]*' | sort -n > "$tmpfile3"
            _sel_seasons="$(cat "$tmpfile3")"
        fi
    fi
    _season_selected() { [ -z "$_sel_seasons" ] && return 0; printf '%s\n' "$_sel_seasons" | grep -qx "$1"; }
    if [ -n "$_sel_seasons" ]; then
        _nsel=$(printf '%s\n' "$_sel_seasons" | wc -l | tr -d ' ')
    else
        _nsel="$_sc"
    fi

    # Count episodes across all selected seasons using the same parser we download from
    _total=0
    _si=1
    while [ "$_si" -le "$_sc" ]; do
        _season_text=$(jq -r ".season_${_si} // empty" "$tmpfile2")
        if [ -n "$_season_text" ] && _season_selected "$_si"; then
            _ep_list=$(parse_episodes "$_season_text" "$quality")
            _ep_list="$(eps_by_request "$_ep_list" "$requested_eps")"
            _n=$(printf '%s\n' "$_ep_list" | grep -c . || true)
            _total=$(( _total + _n ))
        fi
        _si=$(( _si + 1 ))
    done

    # season/episode labels for the confirm: say WHICH season, and pluralize
    if [ "$_nsel" -eq 1 ]; then
        _sel_label="Season ${_sel_seasons:-1}"
    else
        _sel_label="$_nsel seasons"
    fi
    if [ "$_total" -eq 1 ]; then _ep_label="episode"; else _ep_label="episodes"; fi

    printf "\n  ${C_YELLOW}Download ${_total} ${_ep_label} of '${_title}' (${_sel_label})?${C_RESET} [Y/n] "
    if [ -t 0 ]; then
        read -r _yn
        # Enter or y/Y download; anything else (n, N, junk) cancels
        case "$_yn" in
            ""|y|Y) : ;;
            *) exit 0 ;;
        esac
    fi

    _si=1
    _done=0
    while [ "$_si" -le "$_sc" ]; do
        _season_text=$(jq -r ".season_${_si} // empty" "$tmpfile2")
        _ep_list=""
        [ -n "$_season_text" ] && _season_selected "$_si" && _ep_list=$(parse_episodes "$_season_text" "$quality")
        # honor -e N / N-M / -1 inside -D (episode_loop parity); the
        # same narrowing fed the confirm count above
        _ep_list="$(eps_by_request "$_ep_list" "$requested_eps")"
        if [ -n "$_ep_list" ]; then
            # read from a file (not a pipeline) so background jobs and
            # wait work in the current shell for parallel downloads
            printf '%s\n' "$_ep_list" > "$tmpfile3"
            _jobs=0
            _waitpids=""
            _line_no=1
            _prefile="${tmpfile3}.pre"
            _prepid=""
            : > "$_prefile"
            while IFS='	' read -r _num _url _qual _size; do
                _enum=$(printf '%02d' "$_num")
                if [ "$dl_jobs" -gt 1 ]; then
                    # resolve + download in the worker so resolution
                    # overlaps the running downloads instead of
                    # serializing behind each batch's wait
                    quiet_dl=1
                    _hist_si="$_si"; _hist_ep="$_num"
                    ( _r="$(resolve_stream_url "$_url")"
                      if [ -z "$_r" ]; then
                          warn "Episode $_num (S${_si}) unavailable — skipped."
                          exit 0
                      fi
                      do_download "$_r" "${_safe}/season-${_si}/S${_si}E${_enum}"
                    ) &
                    _waitpids="$_waitpids $!"
                    _jobs=$(( _jobs + 1 ))
                    # wait on each PID individually: dash's bare `wait`
                    # returns the last job's status, bash/POSIX return 0
                    [ "$_jobs" -ge "$dl_jobs" ] && {
                        _rc=0
                        for _wp in $_waitpids; do wait "$_wp"; _wr=$?; [ "$_wr" -ge 130 ] && _rc="$_wr"; done
                        _done=$(( _done + _jobs ))
                        _dl_progress "$_done" "$_total"
                        _waitpids=""; _jobs=0
                        [ "$_rc" -ge 130 ] && exit "$_rc"
                    }
                else
                    quiet_dl=""
                    # resolution stalls ~2-3 s/episode (token API +
                    # redirect + probe); hide it by resolving the NEXT
                    # episode's URL in the background while this one
                    # downloads, and reading the prefetch from a file
                    # (first episode resolves inline)
                    if [ "$_line_no" -eq 1 ]; then
                        _r="$(resolve_stream_url "$_url")"
                    else
                        # the prefetch is still resolving unless the
                        # previous download outlasted it; reaping it
                        # first is what stops a fast do_download (an
                        # "Already exists" hit, a 401/403 probe failure,
                        # a rejected error page) from reading an empty
                        # file and cascading "unavailable" for the
                        # rest of the season
                        [ -n "$_prepid" ] && { wait "$_prepid"; _prepid=""; }
                        _r="$(cat "$_prefile" 2>/dev/null)"
                    fi
                    _nl="$(sed -n "$((_line_no + 1))p" "$tmpfile3")"
                    if [ -n "$_nl" ]; then
                        _nu="$(printf '%s' "$_nl" | cut -f2)"
                        ( _pr="$(resolve_stream_url "$_nu")"; printf '%s\n' "$_pr" > "$_prefile" ) &
                        _prepid=$!
                    fi
                    _line_no=$(( _line_no + 1 ))
                    if [ -z "$_r" ]; then
                        warn "Episode $_num (S${_si}) unavailable — skipped."
                        continue
                    fi
                    do_download "$_r" "${_safe}/season-${_si}/S${_si}E${_enum}"
                    _rc=$?
                    [ "$_rc" -ge 130 ] && exit "$_rc"
                    [ "$_rc" -eq 0 ] && { _hist_si="$_si"; _hist_ep="$_num"; }
                    _done=$(( _done + 1 ))
                    _dl_progress "$_done" "$_total"
                fi
            done < "$tmpfile3"
            _rc=0
            for _wp in $_waitpids; do wait "$_wp"; _wr=$?; [ "$_wr" -ge 130 ] && _rc="$_wr"; done
            _done=$(( _done + _jobs ))
            _dl_progress "$_done" "$_total"
            _waitpids=""
            [ "$_rc" -ge 130 ] && exit "$_rc"
        fi
        _si=$(( _si + 1 ))
    done

    # one history line per downloaded title (-c lists it; dedup by
    # slug == this line). Last processed episode across seasons.
    # -D sets info_only, so prompt_action (the only other place _slug
    # is assigned) never runs — read it here or update_history bails.
    _slug="$(jq -r '.url_slug // ""' "$tmpfile2" 2>/dev/null)"
    [ -n "${_hist_ep:-}" ] && update_history "$_slug" "$_title" series "${_hist_si:-0}" "$_hist_ep"

    # Anime-type hicine title (single season) with episodes still
    # missing = their hicine links pointed at a dead bucket. Retry
    # exactly those gaps through the hianime provider — it shares the
    # S{sn}E{ep} naming, so they land in the same folder and nothing
    # already downloaded is touched.
    # an empty _ep_list (a zip-only season has no Episode rows) would
    # build one blank row in the scan below, check a bogus S1E00 and
    # fire a spurious hianime retry
    if [ "$_sc" -eq 1 ] && [ -n "$_ep_list" ] && [ "$(jq -r '.contentType // ""' "$tmpfile2")" = "anime" ]; then
        printf '%s\n' "$_ep_list" > "$tmpfile3"
        _missing=""
        while IFS='	' read -r _num _url _qual _size; do
            _enum=$(printf '%02d' "$_num")
            # dl_find, not a .mp4 test: a source that can't mux into MP4
            # was saved as .mkv, and re-fetching it skews _total
            dl_find "${download_dir}/${_safe}/season-1/S1E${_enum}" >/dev/null ||
                _missing="$_missing $_num"
        done < "$tmpfile3"
        if [ -n "$_missing" ]; then
            info "Retrying missing episodes via hianime:$_missing"
            anime_list="$(anidb_search "$_title" 2>/dev/null || true)"
            # exact title match first, else first result whose title
            # contains ours — avoids grabbing an unrelated show
            _amatch="$(printf '%s\n' "$anime_list" | awk -F'\t' -v t="$_title" 'tolower($2)==tolower(t){print; exit}')"
            [ -z "$_amatch" ] && _amatch="$(printf '%s\n' "$anime_list" | awk -F'\t' -v t="$_title" 'index(tolower($2), tolower(t)){print; exit}')"
            if [ -z "$_amatch" ]; then
                warn "No matching title on hianime — missing episodes stay missing."
            else
                anime_id="$(printf '%s' "$_amatch" | cut -f 1)"
                # keep the hicine title for the destination folder, else
                # the retry lands in a differently-named directory and
                # the gap never closes (anime_title drives _safe)
                anime_title="$_title"
                anime_ep_maps="$(anidb_episodes "$anime_id")"
                if [ -n "$anime_ep_maps" ]; then
                    for _ep in $_missing; do
                        anime_play_episode "$_ep"
                        _rc=$?
                        [ "$_rc" -ge 130 ] && exit "$_rc"
                    done
                else
                    warn "No episodes found on hianime for '$anime_title'."
                fi
            fi
        fi
    fi
    # end of the series part — was an unconditional `exit 0` while inline
    # in the case; a return keeps the function callable from any entry point
    return 0
fi

# Movies: -D downloads the chosen-quality file (same pick as -d)
_title="$(jq -r '.title' "$tmpfile2" | hdec)"
_links=$(jq -r '.links // empty' "$tmpfile2")
if [ -z "$_links" ]; then
    # item-level dead entry: nothing to download and nothing to gap-retry
    warn "No links on server-1 — nothing else to try."
    return 0
fi
_parsed="$(parse_links "$_links")"
if [ -t 0 ]; then
    _new_q=$(printf '%s\n' "$_parsed" | awk -F'\t' '{print $2}' | grep -oE '[0-9]+p' | sort -u \
        | pick_quality_menu "Quality to download: ")
    [ -n "$_new_q" ] && quality="$_new_q"
fi
# same walk as the play path: a dead best variant retries at lower quality
# instead of failing the whole -D
_mresolved=$(movie_playable "$_parsed")
[ -z "$_mresolved" ] && die "No playable source for $_title right now."
_msafe="$(sanitize "$_title")"
mkdir -p "$download_dir"
do_download "$_mresolved" "$_msafe"
_mrc=$?
[ "$_mrc" -ge 130 ] && exit "$_mrc"
if [ "$_mrc" -ne 0 ]; then
    warn "server-1 download failed."
fi
}

# ─── Self-update ────────────────────────────────────────────────────────────

update_script() {
    # refuse early and say why: a /usr/bin binary is the package manager's
    # (AUR), and "Permission denied" on mktemp reads like a bug otherwise
    [ -w "$0" ] || die "Cannot write $0 — update through your package manager (or re-run with sudo for script installs)."
    _repo="${VICINE_UPDATE_URL:-https://raw.githubusercontent.com/spaciousejar/vicine-cli/master/vicine}"
    # Whatever we are about to execute has to come from the project over TLS.
    # VICINE_UPDATE_URL is otherwise an unauthenticated override, and with only
    # the sh -n check below a plaintext URL means arbitrary code execution.
    case "$_repo" in
        https://raw.githubusercontent.com/spaciousejar/vicine-cli/*) ;;
        *) die "Refusing update source outside raw.githubusercontent.com: $_repo" ;;
    esac
    info "Checking for updates..."
    _new="$(curl -sfL --max-time 20 "$_repo")" || die "Update failed: cannot fetch $_repo"
    _new_ver="$(printf "%s" "$_new" | sed -n 's/^version_number="\([^"]*\)"/\1/p')"
    [ -z "$_new_ver" ] && die "Invalid response from update server."

    _cur_ver="$(printf '%s' "$version_number" | tr -dc '0-9.')"
    _nxt_ver="$(printf '%s' "$_new_ver" | tr -dc '0-9.')"
    if [ "$_nxt_ver" = "$_cur_ver" ]; then
        ok "Already up to date ($version_number)"
        exit 0
    fi

    # upgrade only — never downgrade or patch over a never-newer remote
    _newer=$(awk -v cur="$_cur_ver" -v nxt="$_nxt_ver" '
        function max(a,b){return a>b?a:b}
        function cmp(x,y){ n=max(split(x,a,"."), split(y,b,"."));
            for(i=1;i<=n;i++){ av=a[i]+0; bv=b[i]+0; if(av<bv)return -1; if(av>bv)return 1 } return 0 }
        BEGIN { c=cmp(cur,nxt); print (c<0)?1:0 }')
    [ "$_newer" = "1" ] || die "Remote ($_new_ver) is not newer than local ($version_number)"

    # validate the payload before replacing the script
    printf "%s\n" "$_new" | sh -n >/dev/null 2>&1 || die "Fetched script failed syntax check — not updating."
    # atomic replace: write a temp next to the target, then mv. This both
    # surfaces write failures and avoids the running shell reading a half-
    # written file (dash reads scripts in chunks). mktemp, not "$0.tmp.$$" —
    # a predictable name is a symlink-clobber target next to the install.
    _tmp=$(mktemp "$0.XXXXXX") || die "Update failed: cannot create a temp file next to $0"
    if printf "%s\n" "$_new" > "$_tmp" && chmod 755 "$_tmp" && mv -f "$_tmp" "$0"; then
        ok "Updated: $version_number -> $_new_ver"
        exit 0
    fi
    rm -f "$_tmp"
    die "Update failed: cannot write $0 — check permissions or run as the file owner."
}

uninstall_self() {
    _bin="$0"
    case "$_bin" in
        */*) ;;
        *) _bin="$(command -v "$_bin" 2>/dev/null || printf '%s' "$_bin")" ;;
    esac
    case "$_bin" in
        */*) _bin="$(cd "$(dirname "$_bin")" 2>/dev/null && pwd)/$(basename "$_bin")" ;;
    esac
    [ -e "$_bin" ] || die "Cannot locate installed script (expected $_bin)"
    if rm -f "$_bin"; then
        ok "Uninstalled $_bin"
    else
        die "Uninstall failed: cannot remove $_bin — check permissions."
    fi
    if [ -d "$(dirname "$histfile")" ]; then
        warn "Watch history kept at $(dirname "$histfile") — remove manually if undesired"
    fi
    exit 0
}

# ─── Main ───────────────────────────────────────────────────────────────────

# Sourced as a library (VICINE_LIB=1 vicine) by the test suites: defines every
# function and returns here, so tests can call the real implementations
# instead of extracting them with sed. Everything above is declarations.
[ -n "${VICINE_LIB:-}" ] && return 0

# Before anything is created. Without it the watch history landed 0644 in a
# 0755 dir, and every derived /tmp path ("$histfile.tmp", "${tmpfile}.tmp",
# "${tmpfile3}.pre") was a world-readable
# truncating open on a world-visible name.
umask 077

# Config
# Provider order: hicine (this API) is always tried first; hianime (anime)
# is the fallback, via provider_chain().
API="https://api.hicine.sbs"
# HiAnime backend (hianimes.se is a page-only mirror: its /search and /api/*
# routes 307 to /home, so the API calls below must go to hianime.at).
anime_base="https://hianime.at"
# Endpoints are built with ${tmpl%"%s"}$value, not printf: printf's first
# argument is a *format*, so a template that ever gains an env override would
# turn any stray % into a specifier. Invariant: each template ends in exactly
# one literal %s (asserted by tests/anime_plumbing.sh).
anime_search_api="${anime_base}/search?keyword=%s"
anime_episodes_api="${anime_base}/api/theme/episode/list/%s"
anime_servers_api="${anime_base}/api/theme/episode/servers?episodeId=%s"
# playback embeds come from zokoanime.video/…; hls.1embed.buzz CDN is referer-gated
anime_embed_ref="https://zokoanime.video/"
vicine_ua="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
anime_mode="${VICINE_ANIME_MODE:-dub}"
anime_ep_maps=""
anime_ep_list=""
download_dir="${VICINE_DOWNLOAD_DIR:-$HOME/Movies}"
dl_jobs="${VICINE_DL_JOBS:-1}"
no_detach="${VICINE_NO_DETACH:-0}"
info_only=0
download_all_mode=0
menu_program="${VICINE_MENU:-fzf}"
menu_extra_flags="${VICINE_MENU_FLAGS:-}"
result_limit="${VICINE_RESULT_LIMIT:-200}"
quality="${VICINE_QUALITY:-best}"
requested_eps=""
select_nth="${VICINE_SELECT_NTH:-}"
exit_after_play="${VICINE_EXIT_AFTER_PLAY:-0}"
resume_season=""
resume_ep=""
browse_page=1
browse_limit=1000
browse_type=""
histfile="${VICINE_HISTFILE:-$HOME/.local/share/vicine/history}"
mkdir -p "$(dirname "$histfile")" 2>/dev/null

# Tmp files
tmpfile=$(mktemp /tmp/VICINE.XXXXXX)
tmpfile2=$(mktemp /tmp/VICINE.XXXXXX)
tmpfile3=$(mktemp /tmp/VICINE.XXXXXX)
tmpfile4=$(mktemp /tmp/VICINE.XXXXXX)
trap cleanup EXIT
trap on_sigint INT
trap on_sighup HUP
trap on_sigterm TERM

# Curl
curl_exe="curl"
command -v curl >/dev/null 2>&1 || die "curl not found"

# Player detection
case "$(uname -s)" in
    Darwin*)
        player_function="${VICINE_PLAYER:-$(dep_ch_failover "iina,/Applications/IINA.app/Contents/MacOS/iina-cli,mpv")}"
        ;;
    *)
        player_function="${VICINE_PLAYER:-$(dep_ch_failover "mpv,vlc")}"
        ;;
esac

# Non-terminal fallback (only when the user didn't force a menu program)
if [ ! -t 0 ] && [ -z "${VICINE_MENU:-}" ]; then
    command -v dmenu >/dev/null && menu_program=dmenu
    command -v rofi >/dev/null && menu_program=rofi
    # Non-interactive: use first result automatically
    [ -z "$select_nth" ] && select_nth=0
fi

# Parse args
search_mode=""
query=""
while [ $# -gt 0 ]; do
    case "$1" in
        -s|--search)      search_mode="search" ;;
        -A|--anime)       search_mode="anime" ;;
        --dub)            anime_mode="dub" ;;
        --sub)            anime_mode="sub" ;;
        -t|--trending)    search_mode="trending" ;;
        -r|--recent)      search_mode="recent" ;;
        -b|--browse)      search_mode="browse"; shift; _browse_col="$1"; [ -z "$_browse_col" ] && die "Missing collection name for -b" ;;
        -S|--stats)       search_mode="stats" ;;
        -i|--info)        [ -z "$search_mode" ] && search_mode="info"; info_only=1 ;;
        -d|--download)    player_function="download" ;;
        -D|--download-all) info_only=1; download_all_mode=1; [ -z "$search_mode" ] && search_mode="download_all" ;;
        -p|--player)      shift; [ -n "$1" ] || die "Missing value for -p/--player"; player_function="$1" ;;
        -q|--quality)     shift; [ -n "$1" ] || die "Missing value for -q/--quality"; quality="$1" ;;
        -e|--episode)     shift; [ -n "$1" ] || die "Missing value for -e/--episode"; requested_eps="$1" ;;
        -n|--select-nth)  shift; [ -n "$1" ] || die "Missing value for -n/--select-nth"; select_nth="$1" ;;
        -c|--continue)    search_mode="continue" ;;
        -C|--clear-history) search_mode="clear_history" ;;
        --exit-after-play) exit_after_play=1; no_detach=1 ;;
        -U|--update)      update_script ;;
        --uninstall)      uninstall_self ;;
        -V|-v|--version|--v) version_info ;;  # -v/--v are common version aliases
        -h|--help)        help_info ;;
        --rofi)           menu_program="rofi" ;;
        --dmenu)          menu_program="dmenu" ;;
        --no-detach)      no_detach=1 ;;
        --download-dir)   shift; [ -n "$1" ] || die "Missing value for --download-dir"; download_dir="$1" ;;
        --page)           shift; [ -n "$1" ] || die "Missing value for --page"; browse_page="$1" ;;
        --limit)          shift; [ -n "$1" ] || die "Missing value for --limit"; browse_limit="$1" ;;
        help)             help_info ;;
        version)          version_info ;;
        trending|recent|browse|search|info|anime)
            # a bare command word is always a command, never query text —
            # otherwise "-i anime naruto" searched for the literal words
            search_mode="$1"
            ;;
        *)                query="$(printf '%s' "$query $1" | sed 's|^ ||')" ;;
    esac
    shift
done

# -n must be a non-negative integer; jq/arithmetic misbehave on anything
# else. Validated before the dep checks so a missing menu program can't
# mask the real usage error (and empty = interactive selection).
case "$select_nth" in
    "") : ;;
    *[!0-9]*) die "--select-nth must be a non-negative integer" ;;
esac

# multi-select flag per menu program — computed once; menu_program does not
# change after arg parsing. dmenu has no multi-select and gets nothing.
case "$menu_program" in
    fzf)  menu_multi_flag="-m" ;;
    rofi) menu_multi_flag="-multi-select" ;;
    *)    menu_multi_flag="" ;;
esac

# Deps check
dep_ch "sed"
dep_ch "grep"
dep_ch "jq"
dep_ch "$menu_program"
case "$player_function" in
    download) dep_ch_failover "yt-dlp,ffmpeg" >/dev/null || die "Need yt-dlp or ffmpeg for downloads" ;;
    *mpv*) dep_ch mpv ;;
    *iina*)
        # only reachable with an installed IINA (Darwin default fails over to mpv) or -p iina
        case "$player_function" in
            */*) [ -x "$player_function" ] || die "Player not found: $player_function" ;;
            *) command -v "$player_function" >/dev/null 2>&1 || die "iina-cli not found in PATH. Install IINA or set VICINE_PLAYER to the iina-cli path." ;;
        esac
        ;;
    *) dep_ch "$player_function" ;;
esac

# Default to search
[ -z "$search_mode" ] && search_mode="search"

# -D wins over -i regardless of flag order, except for -D -A: anime
# download-all is handled inside cmd_anime, so keep search_mode="anime"
[ "$download_all_mode" = 1 ] && case "$search_mode" in ""|search|info) search_mode="download_all" ;; esac

# Normalize quality: lowercase (480P → 480p...) and 4K/4k → 2160p so -q
# matches variants everywhere; the anime picker's grep is case-sensitive
quality="$(printf '%s' "$quality" | tr '[:upper:]' '[:lower:]')"
[ "$quality" = "4k" ] && quality="2160p"

# Run command
case "$search_mode" in
    search)
        while [ -z "$query" ]; do
            printf "\33[2K\r${C_CYAN}${C_BOLD}  Search ▸ ${C_RESET}"
            read -r query || die "No search query provided."
        done
        cmd_search "$query"
        ;;
    anime)
        while [ -z "$query" ]; do
            printf "\33[2K\r${C_CYAN}${C_BOLD}  Search ▸ ${C_RESET}"
            read -r query || die "No anime search query provided."
        done
        cmd_anime "$query"
        ;;
    trending)  cmd_trending "$query" ;;
    recent)    cmd_recent "$query" ;;
    browse)
        case "$_browse_col" in
            hollywood_movies|movies) browse_type="movies" ;;
            hollywood_series|series) browse_type="series" ;;
            bollywood_series)        browse_type="bolly_series" ;;
            bollywood_movies)        browse_type="bolly_movies" ;;
            anime)                   browse_type="anime" ;;
            *)                       browse_type="" ;;
        esac
        cmd_browse "$_browse_col"
        ;;
    stats)     cmd_stats ;;
    continue)  cmd_history ;;
    clear_history) cmd_clear_history ;;
    info)
        [ -z "$query" ] && die "Missing query for info"
        cmd_search "$query"
        ;;
    download_all)
        [ -z "$query" ] && die "Missing query"
        cmd_search "$query"
        # a fallback provider (anime) finished the download-all
        # itself; its selection lives in tmpfile2 and must not re-enter the
        # hicine download flow below. tmpfile2 exists from startup (mktemp),
        # so an empty/aborted search must be detected by content (-s), not
        # existence — otherwise the flow below runs on a blank item and dies
        # with "integer expected" / "No downloadable links".
        [ "$_backup_used" = "1" ] && exit 0
        [ -s "$tmpfile2" ] || exit 0
        download_all_item
        ;;
esac

[ "$player_function" = "download" ] && exit 0
exit 0
