#!/bin/sh
# vicine - Watch and download anything

version_number="1.0.0"

# ─── UI ─────────────────────────────────────────────────────────────────────

# TTY detection — disable colors when piped
if [ -t 1 ]; then
    ESC=$(printf '\033')
    C_RESET="${ESC}[0m"
    C_BOLD="${ESC}[1m"
    C_DIM="${ESC}[2m"
    C_RED="${ESC}[1;31m"
    C_GREEN="${ESC}[1;32m"
    C_YELLOW="${ESC}[1;33m"
    C_BLUE="${ESC}[1;34m"
    C_CYAN="${ESC}[1;36m"
    C_MAGENTA="${ESC}[1;35m"
    C_WHITE="${ESC}[1;37m"
    C_GRAY="${ESC}[2;37m"
else
    C_RESET=""
    C_BOLD=""
    C_DIM=""
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_BLUE=""
    C_CYAN=""
    C_MAGENTA=""
    C_WHITE=""
    C_GRAY=""
fi

die() {
    printf "\33[2K\r${C_RED}  x %s${C_RESET}\n" "$*" >&2
    exit 1
}

info() {
    printf "\33[2K\r${C_BLUE}  :: %s${C_RESET}\n" "$*"
}

warn() {
    printf "\33[2K\r${C_YELLOW}  :: %s${C_RESET}\n" "$*"
}

ok() {
    printf "\33[2K\r${C_GREEN}  ✓ %s${C_RESET}\n" "$*"
}

# Spinner for long operations
spinner() {
    _msg="$1"
    _sp='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    _i=0
    while kill -0 "$$" 2>/dev/null; do
        printf "\33[2K\r${C_CYAN}  ${_sp:$_i:1} %s${C_RESET}" "$_msg" >&2
        _i=$(( (_i + 1) % ${#_sp} ))
        sleep 0.1
    done &
    _spinner_pid=$!
}

stop_spinner() {
    [ -n "$_spinner_pid" ] && kill "$_spinner_pid" 2>/dev/null
    wait "$_spinner_pid" 2>/dev/null
    printf "\33[2K\r" >&2
}

# $1 = prompt, $2 = extra flags
menu() {
    case "$menu_program" in
        fzf) fzf --reverse --cycle --prompt "$1" $2 $menu_extra_flags ;;
        rofi) rofi -sort -dmenu -i -p "$1" $2 $menu_extra_flags ;;
        dmenu) dmenu -l 20 -p "$1" $menu_extra_flags ;;
        *) "$menu_program" $menu_extra_flags "$1" ;;
    esac
}

