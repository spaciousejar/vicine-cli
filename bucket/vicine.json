{
    "version": "1.7.2",
    "description": "Search, stream, and download movies, series and anime from the terminal",
    "homepage": "https://github.com/spaciousejar/vicine-cli",
    "license": "GPL-3.0",
    "depends": [
        "git",
        "jq",
        "fzf",
        "yt-dlp"
    ],
    "url": "https://github.com/spaciousejar/vicine-cli/archive/refs/tags/v1.7.2.tar.gz",
    "hash": "0d9b271f632ce9dceba6f1391f39db21c9b17865706a88f1e90df01f94a8ed1c",
    "extract_dir": "vicine-cli-$version",
    "installer": {
        "script": "$bash = Join-Path (Split-Path (Split-Path (Get-Command git).Source)) 'bin\\bash.exe'; Set-Content -Path \"$dir\\vicine.cmd\" -Value \"@echo off`r`n@`\"$bash`\" `\"$dir\\vicine`\" %*\" -Encoding Ascii"
    },
    "bin": [
        "vicine.cmd"
    ]
}